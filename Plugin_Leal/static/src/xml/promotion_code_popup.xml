<templates id="template" xml:space="preserve">
    <t t-name="Plugin_Leal.PromotionCodePopup" owl="1">
        <Dialog size="sm" header="false" footer="false">
            <div class="modal-dialog modal-sm" style="max-width: 450px;">
                <div class="modal-content" style="border-radius: 1rem; border: none; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
                    <div class="modal-body" style="padding: 2rem;">
                        <div class="row m-0 p-0">
                            <div class="col-2 p-0">
                                <img class="img img-fluid" src="/Plugin_Leal/static/img/keyboard.png" alt="promotion" />
                            </div>
                            <div class="col-10 p-1">
                                <div class="w-100 h3 font-weight-bolder">
                                    <t t-out="props.title"/>
                                </div>
                                <div class="w-100 h6 font-weight-light text-muted">
                                    <t t-out="props.body"/>
                                </div>
                            </div>
                        </div>
                        <div class="py-2"></div>
                        
                        <!-- Mostrar código enmascarado si existe -->
                        <t t-if="props.promotionCode">
                            <div class="mb-3">
                                <label class="form-label text-muted" style="font-size: 0.9rem; font-weight: 500;">Código detectado:</label>
                                <div class="p-3" style="background: #F9F8F8; border-radius: 0.5rem; border: 1px solid #E0E0E0;">
                                    <span style="font-family: monospace; font-size: 1.1rem; font-weight: 600; letter-spacing: 0.1rem; color: #446FF2;">
                                        <t t-out="maskedCode"/>
                                    </span>
                                </div>
                            </div>
                        </t>
                        
                        <!-- Input para código de promoción -->
                        <div class="mb-3">
                            <label class="form-label text-muted" style="font-size: 0.9rem; font-weight: 500;">Confirme los últimos <t t-out="state.hiddenCharacters"/> dígitos:</label>
                            <input 
                                type="text" 
                                class="form-control" 
                                t-model="state.promotionCode" 
                                t-on-input="onInputChange"
                                t-att-placeholder="'Últimos ' + state.hiddenCharacters + ' dígitos'"
                                t-att-maxlength="state.hiddenCharacters"
                                autofocus="autofocus"
                                style="height: 3rem; border: 1px solid #9F9F9F; border-radius: 0.5rem; font-size: 1rem; font-weight: 500; background: #F9F8F8; padding: 0 1rem; text-align: center; letter-spacing: 0.2rem;"
                            />
                        </div>
                        
                        <!-- Información adicional -->
                        <div class="text-center mb-3">
                            <small class="text-muted" style="font-size: 0.85rem;">
                                Por favor, ingrese los últimos <t t-out="state.hiddenCharacters"/> dígitos para continuar
                            </small>
                        </div>
                    </div>

                    <div class="modal-footer d-flex justify-content-center" style="padding: 1.5rem 2rem; border-top: none; gap: 1rem;">
                        <button class="btn btn-outline-secondary px-4 py-2" t-on-click="cancel" style="border-radius: 0.5rem; font-weight: 500;">
                            <t t-out="props.cancelText || 'Cancelar'"/>
                        </button>
                        <button class="btn btn-warning px-4 py-2" t-on-click="confirm" t-att-disabled="!state.isValid" style="border-radius: 0.5rem; font-weight: 500; background-color: #ffc107; border-color: #ffc107; color: #000;">
                            <t t-out="props.confirmText || 'Confirmar'"/>
                        </button>
                    </div>
                </div>
            </div>
        </Dialog>
    </t>
</templates>