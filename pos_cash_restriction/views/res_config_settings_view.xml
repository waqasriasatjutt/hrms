<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_res_config_form_inherit_pos_zone_printer" model="ir.ui.view">
        <field name="name">POS configuration - Bluetooth Printer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_payment_section']" position="inside">
                <setting string="Cash Restriction" help="This will enable the Cash Restriction">
                    <field name="pos_enable_cash_restriction"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
