<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="CashMovePopup" t-inherit="point_of_sale.CashMovePopup" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('input-amount')]" position="after">
            <div t-if="state.cashSummary" class="text-end pe-3" style="padding-top: 5px;">
                <span class="text-muted small">
                    <strong>Cash in register:</strong>
                    <t t-esc="env.utils.formatCurrency(state.cashSummary.amount)" />
                </span>
            </div>

            <div t-if="state.errorMessage" class="alert alert-danger mt-2 mx-2" role="alert">
                <t t-esc="state.errorMessage" />
            </div>
        </xpath>
    </t>
</templates>
