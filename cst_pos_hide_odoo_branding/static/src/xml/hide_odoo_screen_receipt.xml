<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_debrand.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[@class='pos-receipt-order-data']/p" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
    </t>
    <t t-name="pos_debrand.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[@t-if='!ui.isSmall']//img[hasclass('pos-logo')]" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
    </t>
</templates>
