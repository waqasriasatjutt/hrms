<odoo>
    <!-- Form view -->
    <record id="view_pos_printer_form" model="ir.ui.view">
        <field name="name">qz.printer.form</field>
        <field name="model">qz.printer</field>
        <field name="arch" type="xml">
            <form string="POS Printer">
                <sheet>
                    <group>
                        <field name="name"/>
                        <!-- <field name="pos_category_ids" widget="many2many_tags"/> -->
                        <field name="description"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree view -->
    <record id="view_pos_printer_tree" model="ir.ui.view">
        <field name="name">qz.printer.tree</field>
        <field name="model">qz.printer</field>
        <field name="arch" type="xml">
            <list string="POS Printers">
                <field name="name"/>
                <!-- <field name="pos_category_ids" widget="many2many_tags"/> -->
                <field name="description"/>
                <!--                <field name="company_id"/>-->
            </list>
        </field>
    </record>
    <record id="action_pos_printer" model="ir.actions.act_window">
        <field name="name">POS Printers</field>
        <field name="res_model">qz.printer</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_pos_printer_root" name="POS Printers" sequence="10" parent="point_of_sale.menu_point_root"/>
    <menuitem id="menu_pos_printer" name="Printers" parent="menu_pos_printer_root" action="action_pos_printer"/>

    <!-- Action -->
</odoo>
