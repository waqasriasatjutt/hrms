<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//div[@t-elif='productsToDisplay.length != 0 and pos.session._has_available_products']/ProductCard" position="attributes">
            <attribute name="onTogglePin.bind">() => this.onTogglePin(product)</attribute>
        </xpath>
    </t>
</templates>