<templates id="template" xml:space="preserve">
    <t t-name="wk_customer_address_autocomplete.AdressAutocompleteDropDown">
        <div t-attf-class="dropdown-menu #{results.length ? 'show' : ''}">
            <a class="dropdown-item js_autocomplete_result"
               t-foreach="results" t-as="result" t-key="result"
               t-att-data-google-place-id="result['google_place_id']">
                <t t-out="result['formatted_address']"/>
            </a>
        </div>
    </t>
</templates>
