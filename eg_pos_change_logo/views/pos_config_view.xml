<odoo>
    <record id="res_config_settings_form_view_for_pos_check_info" model="ir.ui.view">
        <field name="name">res.config.settings.form.pos.check.info</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="before">
                <block title="POS Logo" id="pos_interface">
                    <setting id="pos_logo" title="POS Logo" string="POS Logo">
                        <field name="pos_logo" widget="image" style="width:200px;height:200px;"/>
                        <div class="content-group mt16">
                            <div class="text-muted">
                                It will Change Logo in POS.
                            </div>
                        </div>
                    </setting>
                    <setting id="show_logo_receipt" title="Logo on Receipt" string="Logo on Receipt">
                        <field name="show_logo_receipt"/>
                        <div class="content-group mt16">
                            <div class="text-muted">
                                It will to show logo in Receipt.
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
