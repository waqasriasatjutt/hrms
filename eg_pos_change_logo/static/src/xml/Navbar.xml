<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="eg_pos_change_logo.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('pos-centerheader')]" position="replace">
            <div t-if="!ui.isSmall" class="pos-centerheader d-flex justify-content-center overflow-hidden">
                <t t-if="this.pos.config.pos_logo">
                    <img t-att-src="'data:image/png;base64,' + this.pos.config.pos_logo"
                         class="pos-logo pos-logo mw-100" height="42" t-on-click="() => debug.toggleWidget()"
                         alt="Logo"/>
                </t>
                <t t-else="">
                     <img class="pos-logo pos-logo mw-100" height="42" t-on-click="() => debug.toggleWidget()"
                          src="/web/static/img/logo.png" alt="Logo"/>
                </t>
            </div>
        </xpath>
    </t>
</templates>