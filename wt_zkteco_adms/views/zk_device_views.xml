<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_zk_device_list" model="ir.ui.view">
        <field name="name">zk.device.list</field>
        <field name="model">zk.device</field>
        <field name="arch" type="xml">
            <list string="ZKTeco Devices" decoration-muted="not is_active">
                <field name="name"/>
                <field name="serial_number"/>
                <field name="location"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="last_seen"/>
                <field name="punch_count"/>
                <field name="unprocessed_count"/>
                <field name="unmatched_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_zk_device_form" model="ir.ui.view">
        <field name="name">zk.device.form</field>
        <field name="model">zk.device</field>
        <field name="arch" type="xml">
            <form string="ZKTeco Device">
                <header>
                    <button name="action_reprocess_unprocessed" type="object"
                            string="Reprocess Unprocessed Punches"
                            class="btn-primary" icon="fa-refresh"/>
                    <button name="action_ping_url" type="object"
                            string="Show Device URL"
                            class="btn-secondary" icon="fa-info-circle"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_punches" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="punch_count" widget="statinfo" string="Punches"/>
                        </button>
                        <button name="action_view_punches" type="object"
                                class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="unmatched_count" widget="statinfo" string="Unmatched"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Inactive"
                            bg_color="text-bg-danger" invisible="is_active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Main Office Device"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="serial_number"/>
                            <field name="location"/>
                            <field name="is_active"/>
                            <field name="timezone_offset"/>
                        </group>
                        <group>
                            <field name="last_seen"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1" placeholder="Free text notes…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zk_device_search" model="ir.ui.view">
        <field name="name">zk.device.search</field>
        <field name="model">zk.device</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="serial_number"/>
                <field name="location"/>
                <filter string="Active" name="active" domain="[('is_active','=',True)]"/>
                <filter string="Inactive" name="inactive" domain="[('is_active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_zk_device" model="ir.actions.act_window">
        <field name="name">ZK Devices</field>
        <field name="res_model">zk.device</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No devices registered yet.
            </p>
            <p>
                Devices are auto-registered (inactive) when they first post to
                <code>/iclock/cdata</code>. Set the Cloud Server URL on the
                device and it will show up here within a minute or two.
            </p>
        </field>
    </record>

</odoo>
