<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_employee_form_zk" model="ir.ui.view">
        <field name="name">hr.employee.form.zk</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Add ZKTeco User ID as its own row in the identification group
                 (HR Settings tab), right after the PIN code field. -->
            <xpath expr="//group[@name='identification_group']/field[@name='pin']" position="after">
                <field name="zk_user_id"/>
            </xpath>
        </field>
    </record>

</odoo>
