<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_dojo_validation" model="ir.cron">
        <field name="name">Dojo Validation</field>
        <field name="model_id" ref="base.model_res_config_settings"/>
        <field name="state">code</field>
        <field name="code">model._validate_smart_dojo_key()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=0, minute=30) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')" />
    </record>
</odoo>
