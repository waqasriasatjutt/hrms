<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="homepage" inherit_id="website.homepage" name="WT Theme Hotel Homepage" priority="40">
    <xpath expr="//div[@id='wrap']" position="replace">
        <div id="wrap" class="oe_structure oe_empty">
            <t t-call="wt_theme_hotel.s_hotel_hero"/>
            <t t-call="wt_theme_hotel.s_hotel_services"/>
            <t t-call="wt_theme_hotel.s_hotel_features"/>
            <t t-call="wt_theme_hotel.s_hotel_showcase"/>
            <t t-call="wt_theme_hotel.s_hotel_team"/>
            <t t-call="wt_theme_hotel.s_hotel_testimonials"/>
            <t t-call="wt_theme_hotel.s_hotel_faq"/>
            <t t-call="wt_theme_hotel.s_hotel_cta"/>
            <t t-call="wt_theme_hotel.s_hotel_contact"/>
        </div>
    </xpath>
</template>
</odoo>
