<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_hotel_hero" name="WT Theme Hotel Hero">
    <section class="wtt-hero">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-7">
                    <span class="wtt-eyebrow mb-3">A Boutique Hotel On The Coast</span>
                    <h1 class="wtt-h1">A Quieter <span style="color:#1A4D5C;">Coast.</span></h1>
                    <p class="wtt-lead">Sixteen rooms. One restaurant. A garden that runs to the cliffs. We're not the biggest hotel on the coast — we're the one you remember.</p>
                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <a href="#contact" class="btn btn-lg wtt-btn-primary">Book A Stay</a>
                        <a href="#services" class="btn btn-lg wtt-btn-outline">See Rooms</a>
                    </div>
                    <div class="wtt-hero__stats"><div class="stat"><div class="num">16</div><div class="label">Rooms</div></div><div class="stat"><div class="num">4.9★</div><div class="label">Tripadvisor</div></div><div class="stat"><div class="num">15+</div><div class="label">Years Open</div></div></div>
                </div>
                <div class="col-lg-5 d-none d-lg-block">
                    <div class="wtt-hero__visual">
                        <i class="bg-glyph fa fa-circle-o-notch"/>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
