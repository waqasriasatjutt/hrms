<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_education_hero" name="WT Theme Education Hero">
    <section class="wtt-hero">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-7">
                    <span class="wtt-eyebrow mb-3">Founded 1962</span>
                    <h1 class="wtt-h1">Where Curiosity Meets <span style="color:#1E40AF;">Capability.</span></h1>
                    <p class="wtt-lead">A small, fiercely academic institution. 12 students per teacher. 92% go on to top-50 universities. The rest are usually coding for unicorns.</p>
                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <a href="#contact" class="btn btn-lg wtt-btn-primary">Apply Now</a>
                        <a href="#services" class="btn btn-lg wtt-btn-outline">Programmes</a>
                    </div>
                    <div class="wtt-hero__stats"><div class="stat"><div class="num">12:1</div><div class="label">Student-Teacher</div></div><div class="stat"><div class="num">92%</div><div class="label">Top-50 University</div></div><div class="stat"><div class="num">60+</div><div class="label">Years Educating</div></div></div>
                </div>
                <div class="col-lg-5 d-none d-lg-block">
                    <div class="wtt-hero__visual">
                        <i class="bg-glyph fa fa-circle-o-notch"/>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
