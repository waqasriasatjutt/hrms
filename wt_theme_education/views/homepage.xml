<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="homepage" inherit_id="website.homepage" name="WT Theme Education Homepage" priority="40">
    <xpath expr="//div[@id='wrap']" position="replace">
        <div id="wrap" class="oe_structure oe_empty">
            <t t-call="wt_theme_education.s_education_hero"/>
            <t t-call="wt_theme_education.s_education_services"/>
            <t t-call="wt_theme_education.s_education_features"/>
            <t t-call="wt_theme_education.s_education_showcase"/>
            <t t-call="wt_theme_education.s_education_team"/>
            <t t-call="wt_theme_education.s_education_testimonials"/>
            <t t-call="wt_theme_education.s_education_faq"/>
            <t t-call="wt_theme_education.s_education_cta"/>
            <t t-call="wt_theme_education.s_education_contact"/>
        </div>
    </xpath>
</template>
</odoo>
