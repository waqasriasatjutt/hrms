<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--  PAYRILLIUM CONFIGURATION FORM VIEW (SETTINGS SCREEN) -->
    <record id="view_payrillium_config_form" model="ir.ui.view">
        <field name="name">payrillium.config.form</field>
        <field name="model">payrillium.config</field>
        <field name="arch" type="xml">
            <form string="Payrillium Configuration" create="0" delete="0">
                <header>
                    <button name="open_payrillium_wizard"
                            string="Activate Payrillium"
                            type="object"
                            class="btn-primary"
                            icon="fa-cog"
                            invisible="installed"/>
                    <button name="open_payrillium_wizard"
                            string="Update Configuration"
                            type="object"
                            class="btn-primary"
                            icon="fa-refresh"
                            invisible="not installed"/>
                </header>
                <sheet>
                    <group>
                        <div class="alert alert-warning" role="alert" invisible="installed">
                            <strong>Payrillium is not activated.</strong><br/>
                            Click "Activate Payrillium" button above to configure your API token and enable payment methods.
                        </div>
                        <field readonly="1" name="token" string="Code" password="True"/>
                        <field readonly="1" name="pbl_request_phone"/>
                        <field readonly="1" name="pbl_request_shipping"/>
                        <field readonly="1" name="receivable_account_id" string="Receivable Account"/>
                        <field readonly="1" name="outstanding_account_id" string="Outstanding Account"/>
                        <field name="auto_sync_enabled" widget="boolean_toggle"/>
                        <field readonly="1" name="version" string="Version"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!--  WINDOW ACTIONS TO OPEN VIEWS -->
    <record id="action_payrillium_terminals" model="ir.actions.act_window">
        <field name="name">Payrillium Terminals</field>
        <field name="res_model">payrillium.terminal</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Manage your Payrillium payment terminals here.</p>
        </field>
    </record>
    <record id="payrillium_open_settings_action" model="ir.actions.server">
        <field name="name">Open Payrillium Settings</field>
        <field name="model_id" ref="model_payrillium_config"/>
        <field name="state">code</field>
        <field name="code">config_id = env['payrillium.config'].get_singleton_id()
action = {
'type': 'ir.actions.act_window',
'name': 'Payrillium Configuration',
'res_model': 'payrillium.config',
'view_mode': 'form',
'views': [(env.ref('pos_payrillium.view_payrillium_config_form').id, 'form')],
'res_id': config_id,
'target': 'current',
}</field>
    </record>
 <!--    ACTIONS FOR TERMINAL OPERATIONS -->
    <record id="action_test_payrillium_terminal" model="ir.actions.server">
        <field name="name">Test Terminal</field>
        <field name="model_id" ref="model_payrillium_terminal"/>
        <field name="binding_model_id" ref="model_payrillium_terminal"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
if len(records) != 1:
    raise UserError("Please select exactly one terminal to test.")
action = records.action_check_terminal()
        </field>
    </record>

    <record id="action_unlink_payrillium_terminal" model="ir.actions.server">
        <field name="name">Unlink Terminal</field>
        <field name="model_id" ref="model_payrillium_terminal"/>
        <field name="binding_model_id" ref="model_payrillium_terminal"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
if len(records) != 1:
    raise UserError("Please select exactly one terminal to unlink.")
action = records.action_unlink_terminal()
        </field>
    </record>

    <record id="action_reset_payrillium_terminal" model="ir.actions.server">
        <field name="name">Reset Terminal</field>
        <field name="model_id" ref="model_payrillium_terminal"/>
        <field name="binding_model_id" ref="model_payrillium_terminal"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
if len(records) != 1:
    raise UserError("Please select exactly one terminal to reset.")
action = records.action_abort_terminal()
        </field>
    </record>

    <menuitem id="menu_payrillium_root"
              name="Payrillium"
              parent="point_of_sale.menu_point_root"
              sequence="100"/>
    <menuitem id="menu_payrillium_settings"
              name="Settings"
              parent="menu_payrillium_root"
              action="pos_payrillium.payrillium_open_settings_action"
              sequence="5"/>

    <menuitem id="menu_payrillium_terminals"
              name="Terminals"
              parent="menu_payrillium_root"
              action="pos_payrillium.action_payrillium_terminals"
              sequence="10"/>

    <record id="view_payrillium_terminal_list" model="ir.ui.view">
        <field name="name">payrillium.terminal.list</field>
        <field name="model">payrillium.terminal</field>
        <field name="arch" type="xml">
            <list string="Payrillium Terminals" create="0" delete="0" duplicate="0" import="0" export_xlsx="1"> 
                <field name="name"/>
                <field name="serial"/>
                <field name="pos_config_name" string="POS Config"/>
            </list>
        </field>
    </record>
    


    <record id="view_payrillium_terminal_form" model="ir.ui.view">
        <field name="name">payrillium.terminal.form</field>
        <field name="model">payrillium.terminal</field>
        <field name="arch" type="xml">
            <form string="Payrillium Terminal" create="0" delete="0">
                <header>
                    <button name="action_check_terminal"
                            type="object"
                            string="Check Terminal"
                            class="oe_highlight"
                            icon="fa-wifi"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="serial"/>
                        <field name="pos_config_name" string="POS Config"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    


</odoo>
