<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="product_pos_create_item.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('status-buttons')]" position="inside">
            <div id="rwcNavbarBtn" class="btn rwc-btn-navbar border-0 rounded-0 not-clickable" t-on-click="onRewardsCodesButtonClick" position="before">
                <span class="rewards_codes d-flex align-items-center gap-1">
                    <i aria-hidden="true" class="fa fa-gift"></i>
                    <span class="rewards_codes_name">Rewards Codes</span>
                </span>
            </div>
        </xpath>
    </t>
</templates>
