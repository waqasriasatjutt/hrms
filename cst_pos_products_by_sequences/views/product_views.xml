<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_pos_sequence" model="ir.ui.view">
        <field name="name">Product.template.view.form.inherit.pos.product.sequence</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos']//group[@name='pos']//field[@name='pos_categ_ids']" position="after">
                <field name="pos_sequence"/>
            </xpath>
        </field>
    </record>
</odoo>