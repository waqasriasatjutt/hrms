<odoo>
    <record id="eg_pos_auto_invoice_check_res_config_settings_view_form_demo" model="ir.ui.view">
        <field name="name">eg.pos.auto.invoice.check.res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="eg_app_base.eg_app_base_res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='eg_app_base']" position="after">
                <block title="POS Auto Invoice Check" id="eg_pos_auto_invoice_check">
                    <setting help="eg_pos_auto_invoice_check" id="allow_auto_invoice_true">
                        <field name="allow_auto_invoice_true"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>