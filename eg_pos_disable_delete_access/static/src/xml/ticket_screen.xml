<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="eg_pos_disable_delete_access.TicketScreen" t-inherit="point_of_sale.TicketScreen"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('delete-button')]" position="replace">
             <div t-if="!shouldHideDeleteButton(order) and this.pos.config.eg_pos_disable_delete_access_enable and this.pos.user.disable_delete_access"
                  class="col very-narrow delete-button p-2" name="delete"
             >
            </div>
            <div t-elif="!shouldHideDeleteButton(order)"
                 class="col very-narrow delete-button p-2" name="delete"
                 t-on-click.stop="() => this.pos.onDeleteOrder(order)">
                <i class="fa fa-trash" aria-hidden="true"/>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('rounded-2')]" position="replace">
            <div t-if="!shouldHideDeleteButton(order) and this.pos.config.eg_pos_disable_delete_access_enable and this.pos.user.disable_delete_access"

            >

            </div>
            <div t-elif="!shouldHideDeleteButton(order)"
                 class="col very-narrow delete-button p-2 rounded-2" name="delete"
                 t-on-click.stop="() => this.pos.onDeleteOrder(order)">
                            <i class="fa fa-trash" aria-hidden="true"/>
                Delete
            </div>
        </xpath>
    </t>
</templates>
