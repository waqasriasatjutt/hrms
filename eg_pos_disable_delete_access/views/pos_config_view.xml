<odoo>
    <record id="eg_pos_disable_delete_access_res_config_settings_view_form_demo" model="ir.ui.view">
        <field name="name">eg.pos.validation.res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="eg_app_base.eg_app_base_res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='eg_app_base']" position="after">
                <block title="POS Disable Delete Access" id="eg_pos_disable_delete_access">
                    <setting help="eg_pos_disable_delete_access" id="eg_pos_disable_delete_access_enable">
                        <field name="eg_pos_disable_delete_access_enable"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
