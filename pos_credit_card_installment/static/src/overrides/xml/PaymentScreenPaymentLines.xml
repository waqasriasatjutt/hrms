<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="PaymentScreenPaymentLines" t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension">
        
        <xpath expr="//div[@class='payment-infos d-flex align-items-center justify-content-between flex-grow-1 px-3 py-3 text-truncate cursor-pointer fs-2']/.." position="after">
            
            <!-- Installment Selection Panel -->
            <div t-if="line.payment_method_id and line.payment_method_id.card_id" class="installment-panel bg-light border rounded-3 p-3 mx-2 mt-2 shadow-sm">

                <!-- Compact Amount Display and Installment Selector -->
                <div class="d-flex align-items-center justify-content-between gap-3">
                    <!-- Amount Display - Left Side -->
                    <div class="amount-display text-start">
                        <small class="text-muted d-block mb-1">Monto total a pagar</small>
                        <strong class="fs-4 text-dark">
                            <t t-set="displayAmount" t-value="line.surcharge_coefficient ? line.amount * line.surcharge_coefficient : line.amount"/>
                            <t t-esc="env.utils.formatCurrency(displayAmount) or env.utils.formatCurrency(line.amount)"/>
                        </strong>
                    </div>

                    <!-- Installment Selector - Right Side -->
                    <div class="installment-selector flex-fill">
                        <label class="form-label fw-semibold mb-2 d-flex align-items-center">
                            <i class="fa fa-list-alt me-2 text-primary"></i>
                            Plan de cuotas:
                        </label>
                        <select class="form-select shadow-sm"
                                id="installment"
                                name="installment"
                                t-on-change="(ev) => pos.captureChange(ev)"
                                style="border: 2px solid #0d6efd; font-size: 0.9rem;">
                            <option value="" class="text-muted">🔽 Seleccione una opción</option>
                            <t t-if="pos.account_card_installment and pos.account_card_installment.length > 0">
                                <t t-set="amount" t-value="line.amount" />
                                <t t-set="line_key" t-value="line.uuid || line.cid || 'unknown'" />
                                <t t-foreach="pos.account_card_installment" t-as="installment" t-key="line_key + '_inst_' + (installment.id || installment_index)" t-if="installment and installment.id">
                                    <option t-if="line.payment_method_id.card_id and installment.card_id and line.payment_method_id.card_id.id == installment.card_id[0]"
                                            t-att-value="installment.id"
                                            t-att-data-installment="installment.installment"
                                            t-att-data-surcharge="installment.surcharge_coefficient">
                                        <t t-if="installment.installment == 1">
                                            💳 Contado - <t t-esc="env.utils.formatCurrency(amount * installment.surcharge_coefficient)"/>
                                            <t t-if="installment.surcharge_coefficient > 1.0">
                                                (+<t t-esc="Math.round((installment.surcharge_coefficient - 1) * 100)"/>%)
                                            </t>
                                        </t>
                                        <t t-else="">
                                            📅 <t t-esc="installment.installment"/> x <t t-esc="env.utils.formatCurrency((amount * installment.surcharge_coefficient) / installment.installment)"/>
                                            = <t t-esc="env.utils.formatCurrency(amount * installment.surcharge_coefficient)"/>
                                            <t t-if="installment.surcharge_coefficient > 1.0">
                                                (+<t t-esc="Math.round((installment.surcharge_coefficient - 1) * 100)"/>%)
                                            </t>
                                        </t>
                                    </option>
                                </t>
                            </t>
                        </select>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>