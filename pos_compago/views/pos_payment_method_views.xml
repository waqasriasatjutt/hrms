<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_pos_compago" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.compago</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field name="compago_api_key"
                       invisible="use_payment_terminal != 'compago'"
                       required="use_payment_terminal == 'compago'"
                       password="True"/>

                <field name="compago_environment"
                       widget="selection"
                       invisible="use_payment_terminal != 'compago'"
                       required="use_payment_terminal == 'compago'"/>

                <field name="compago_api_url"
                       invisible="use_payment_terminal != 'compago' or compago_environment != 'local'"
                       required="use_payment_terminal == 'compago'"/>

                <field name="compago_terminal_serial_number"
                       invisible="use_payment_terminal != 'compago'"
                       required="use_payment_terminal == 'compago'"/>

                <field name="compago_should_deep_link_to_app"
                       widget="boolean_toggle"
                       invisible="use_payment_terminal != 'compago'"
                       required="use_payment_terminal == 'compago'"/>
            </xpath>
        </field>
    </record>
</odoo>
