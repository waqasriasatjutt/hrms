<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.OrderWidget" t-inherit-mode="extension">

        <xpath expr="//t[@t-set='taxTotals']" position="after">
            <t t-if="props.lines">

                <div class="d-flex justify-content-between w-100 fs-6 text-muted px-3 pt-3 total_lines">
                Unique Products
                    <span t-esc="uniqueProducts"/>
                </div>

                <div class="d-flex justify-content-between w-100 fs-6 text-muted px-3 total_lines">
                Total Lines
                    <span t-esc="totalLines"/>
                </div>

                <div class="d-flex justify-content-between w-100 fs-6 text-muted px-3 pb-3 total_lines">
                Total Quantity
                    <span t-esc="totalQty"/>
                </div>
            </t>

        </xpath>
    </t>
</templates>
