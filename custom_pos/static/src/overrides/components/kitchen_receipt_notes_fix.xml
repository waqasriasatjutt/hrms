        <!-- Add customer notes under each orderline (no header, just the note text) -->
        <!-- Customer notes are added to each changedline in kitchen_receipt_variant_order_patch.js -->
        <!-- Add customer notes after internal notes (fst-italic divs) in each orderline -->
        <xpath expr="//div[@class='pos-receipt-body pb-5']//div[@class='fst-italic']" position="after">
            <t t-if="line and line.customerNote and line.customerNote.trim()">
                <div class="kitchen-customer-note" style="margin-left: 16px; margin-top: 4px; font-size: 18pt; font-weight: normal; line-height: 1.4;">
                    <t t-esc="line.customerNote"/>
                </div>
            </t>
        </xpath>



<xpath expr="//div[@class='mt-5 fst-italic']" position="replace">
