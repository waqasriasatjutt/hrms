</xpath>

        <!-- Add all notes after order lines (only once each) - BIGGER FONTS for thermal printer -->
        <!-- Note: Default order_note is hidden with CSS to prevent duplication (we show it with "MESSAGE:" header below) -->
        <xpath expr="//div[@class='pos-receipt-body pb-5']" position="after">
            <t t-if="changes.custom_note and changes.custom_note.length">
                <div class="mt-4 mb-3" style="font-size: 100%; font-weight: bold;">
                    <strong style="font-size: 100%; text-align: center; text-transform: uppercase;">General Note:</strong><br/>
                    <div style="margin-top: 8px; font-size: 100%; font-weight: normal; line-height: 1.4;">
                        <t t-esc="changes.custom_note.split('\n').join(', ')"/><br/>
                    </div>
                </div>
            </t>
            
                <t t-if="(!changedlines.length or fullReceipt) and changes.order_note.length">
                <div class="mt-4 mb-3" style="font-size: 100%; font-weight: bold;">
                        <t t-if="changes.order_note">
                    <strong style="font-size: 100%;text-align: center; text-transform: uppercase;">Printed Note:</strong><br/>
                    <div style="margin-top: 8px; font-size: 100%; font-weight: normal; line-height: 1.4;">
