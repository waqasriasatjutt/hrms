<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="OrderlineVariantAfterQty"
       t-inherit="point_of_sale.Orderline"
       t-inherit-mode="extension"
       owl="1">

        <!-- ========================================================= -->
        <!-- 1️⃣ PRODUCT NAME → BASE NAME ONLY (NO VARIANTS HERE) -->
        <!-- ========================================================= -->
<!-- REMOVE QTY FROM PRICE-PER-UNIT -->
<xpath expr="//li[contains(@class,'price-per-unit')]" position="replace">
<li class="price-per-unit">
        <!-- <span class="qty px-1 border rounded text-bg-view fw-bolder me-1"
              t-esc="line.qty"/> -->

        <div t-if="line.qty !== '1.00'">

        <span class="qty px-1 border rounded text-bg-view fw-bolder me-1"
              t-esc="line.qty"/>

        <t t-if="!props.basic_receipt">
            x
            <t t-if="line.price !== 0">
                <s t-esc="line.oldUnitPrice" t-if="line.oldUnitPrice"/>
                <t t-esc="line.unitPrice"/>
            </t>
            /
        </t>

        <t t-if="line.unit" t-esc="line.unit"/>
</div>
    </li>
</xpath>

    
        <xpath expr="//div[contains(@class, 'product-name')]" position="replace">

    <div class="d-flex align-items-start gap-2">

<span class="qty border rounded text-bg-view fw-bolder"
      style="min-width: 1.8rem; text-align:center;"
      t-esc="+line.qty % 1 === 0 ? +line.qty : line.qty"/>


            <div class="product-name d-inline-block flex-grow-1 fw-bolder pe-1">
                <t t-set="full_name" t-value="line.productName or ''"/>
                <t t-set="first_paren" t-value="full_name.indexOf('(')"/>

                <!-- Base name only -->
                <span class="text-wrap d-block fw-bolder"
                      dir="ltr"
                      style="white-space:normal; word-break:break-word; text-align:left; direction:ltr !important;"
                      t-esc="first_paren > 0
                             ? full_name.substring(0, first_paren).trim()
                             : full_name"/>

                <t t-slot="product-name"/>
            </div>
        </div>
        </xpath>

        <!-- ========================================================= -->
        <!-- 2️⃣ REMOVE ORIGINAL INTERNAL NOTE CONTAINER -->
        <!-- ========================================================= -->
        <xpath expr="//div[contains(@class, 'internal-note-container')]" position="replace">
            <!-- Remove it completely -->
        </xpath>


        <!-- ================= REMOVE ORIGINAL DISCOUNT ================= -->
        <xpath expr="//li[@t-if]" position="attributes">
            <attribute name="t-if">false</attribute>
        </xpath>

        <!-- ========================================================= -->
        <!-- 3️⃣ REMOVE ORIGINAL CUSTOMER NOTE -->
        <!-- ========================================================= -->
        <xpath expr="//li[contains(@class, 'customer-note')]" position="replace">
            <!-- Remove it completely -->
        </xpath>

        <!-- ========================================================= -->
        <!-- 4️⃣ INSERT VARIANTS + INTERNAL NOTE + CUSTOMER NOTE AFTER QTY × UNIT PRICE -->
        <!-- ========================================================= -->
        <xpath expr="//li[contains(@class, 'price-per-unit')]" position="after">

            <!-- VARIANTS -->
            <t t-set="full_name" t-value="line.productName or ''"/>
            <t t-set="first_paren" t-value="full_name.indexOf('(')"/>

            <t t-if="first_paren > 0">
                <t t-set="all_variants" t-value="full_name.substring(first_paren)"/>
                <t t-set="split_pos" t-value="all_variants.indexOf(') (')"/>

                <!-- Multiple variant groups -->
                <t t-if="split_pos > 0">
                    <!-- Multiple variant groups -->
                    <li class="fst-italic text-break variant-line"
                        style="font-family:'Courier New', monospace;
                               font-weight:800;
                               font-size:100%;
                               white-space:normal;
                               word-break:break-word;
                               color:#000000;">
                        <t t-esc="all_variants.substring(0, split_pos + 1).trim()"/>
                    </li>

                    <li class="fst-italic text-break variant-line"
                        style="font-family:'Courier New', monospace;
                               font-weight:800;
                               font-size:100%;
                               white-space:normal;
                               word-break:break-word;
                               color:#000000;">
                        <t t-esc="all_variants.substring(split_pos + 2).trim()"/>
                    </li>
                </t>

                <!-- Single variant group -->
                <t t-else="">
                    <!-- Single variant group -->
                    <li class="fst-italic text-break variant-line"
                        style="font-family:'Courier New', monospace;
                               font-weight:800;
                               font-size:100%;
                               white-space:normal;
                               word-break:break-word;
                               color:#000000;">
                        <t t-esc="all_variants"/>
                    </li>
                </t>
            </t>

            <!-- INTERNAL NOTE -->
<!-- INTERNAL NOTE -->
<!--<t t-if="line.internalNote">-->
<!--    <t t-foreach="line.internalNote?.split?.('\n') or []" t-as="note" t-key="note_index">-->
<!--        <div t-if="note.trim() !== ''"-->
<!--            class="internal-note w-100 p-2 rounded bg-info bg-opacity-25 text-info text-break"-->
<!--            style="font-size:0.85rem;">-->
<!--            <i class="fa fa-info-circle me-1"/>-->
<!--            <t t-esc="note"/>-->
<!--        </div>-->
<!--    </t>-->
<!--</t>-->

<!--            &lt;!&ndash; DISCOUNT (BEFORE INTERNAL NOTE) &ndash;&gt;-->
<!--            <li t-if="line.price !== 0 and line.discount and line.discount !== '0' and !props.basic_receipt" class="info-list d-flex flex-column">-->
<!--                <t t-esc="line.price_without_discount"/> With a <em><t t-esc="line.discount" />-->
<!--                % </em> discount-->
<!--            </li>-->

            <li t-if="line.price !== 0 and line.discount and line.discount !== '0' and !props.basic_receipt">
                <t t-esc="line.price_without_discount"/> With a
                <em><t t-esc="(+line.discount || 0).toFixed(2)"/>%</em> discount
            </li>



            <t t-if="line.internalNote">
                <t t-foreach="line.internalNote?.split?.('\n') or []"
                   t-as="note"
                   t-key="note_index">

                    <div t-if="note.trim() !== ''"
                         class="internal-note text-break"
                         style="
                            font-size: 0.85rem;
                            line-height: 1.3;
                            box-sizing: border-box;
                            max-width: 100%;
                            overflow-wrap: break-word;
                            word-break: break-word;
                            margin-top: 2px;
                         ">
                        <i class="fa fa-info-circle me-1"/>
                        <t t-esc="note"/>
                    </div>

                </t>
            </t>


           <t t-if="line.customerNote">
               <li class="customer-note w-100 p-2 rounded bg-warning bg-opacity-25 text-break">
                   <i class="fa fa-sticky-note me-1"/>
                   <t t-esc="line.customerNote"/>
               </li>
           </t>

        </xpath>


    </t>
</templates>
