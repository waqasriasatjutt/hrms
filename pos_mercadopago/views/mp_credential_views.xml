<?xml version="1.0"?>
<odoo>
    <data>
        <record id="view_mp_credential_form" model="ir.ui.view" >
            <field name="name">Credenciales</field>
            <field name="model">mp.credential</field>
            <field name="arch" type="xml">
                <form string="Credenciales">
                    <header>
                        <button string="1. Autorizar Aplicación" type="object" name="generate_authorization_url" class="btn-primary" 
                                icon="fa-external-link" help="Abrir URL de autorización de MercadoPago"
                                invisible="not client_id or not redirect_uri or refresh_token"/>
                        <button string="2. Intercambiar Código" type="object" name="exchange_authorization_code" class="btn-success"
                                icon="fa-exchange" help="Intercambiar código de autorización por tokens"
                                invisible="not authorization_code"/>
                        <button string="Refrescar Token" type="object" name="refresh_oauth_token" class="btn-secondary"
                                icon="fa-refresh" help="Refrescar token existente usando refresh_token"
                                invisible="not refresh_token"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                           <label for="name"/>
                           <h1><field name="name"/></h1>
                        </div>
                        <group col="2">
                            <group string="Configuración General">
                                <field name="mp_url"/>
                                <field name="platform_id" invisible="1"/>
                                <field name="integrator_id" invisible="1"/>
                                <field name="payment_type" required="1"/>
                                <field name="company_id" readonly="1"/>
                            </group>
                            <group string="OAuth Configuración">
                                <field name="client_id" required="1"/>
                                <field name="client_secret" password="True" required="1"/>
                                <field name="mp_webhook_secret" password="True" required="1"/>
                                <field name="redirect_uri" invisible="1" placeholder="https://yourdomain.com/mercadopago/oauth/callback"
                                       help="Must match the URL configured in your MercadoPago application's 'URLs de redireccionamiento'"/>
                                <field name="authorization_code" invisible="1" help="Paste the code received from authorization callback"/>
                                <field name="state" invisible="1" readonly="1"/>
                            </group>
                        </group>
                        <group col="2">
                            <group string="Token de Acceso">
                                <field name="mp_access_token" password="True" readonly="1" invisible="1"
                                       placeholder="Token no generado aún"/>
                                <field name="refresh_token" readonly="1" invisible="1"/>
                                <field name="public_key" readonly="1" invisible="1"
                                       placeholder="Clave pública no disponible"/>
                                <field name="user_id" readonly="1" string="ID de Usuario"/>
                                <field name="live_mode" readonly="1" widget="boolean_toggle" string="Modo Producción"/>
                            </group>
                            <group string="Información de Expiración">
                                <field name="expires_in" readonly="1" string="Expira en (segundos)"/>
                                <field name="token_obtained_date" readonly="1" string="Fecha de Obtención"/>
                                <field name="token_expiry_date" readonly="1" string="Fecha de Expiración"/>
                                <field name="scope" readonly="1" string="Permisos" 
                                       invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_mp_credential_tree" model="ir.ui.view">
            <field name="name">Credenciales</field>
            <field name="model">mp.credential</field>
            <field name="arch" type="xml">
                <list string="Card Reader">
                    <field name="name"/>
                    <field name="company_id" readonly="1"/>
                </list>
            </field>
        </record>

        <record id="action_mp_credential_form" model="ir.actions.act_window">
            <field name="name">Credenciales</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mp.credential</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_mp_credential_config" parent="point_of_sale.menu_point_config_product" name='MP' sequence="35"/>
        <menuitem parent="pos_mercadopago.menu_mp_credential_config" action="pos_mercadopago.action_mp_credential_form" id="menu_mp_credential" sequence="36"/>
    </data>
</odoo>
