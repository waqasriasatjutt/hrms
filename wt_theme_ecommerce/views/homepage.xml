<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="homepage" inherit_id="website.homepage" name="WT Theme eCommerce Homepage" priority="40">
    <xpath expr="//div[@id='wrap']" position="replace">
        <div id="wrap" class="oe_structure oe_empty">
            <t t-call="wt_theme_ecommerce.s_ecommerce_hero"/>
            <t t-call="wt_theme_ecommerce.s_ecommerce_services"/>
            <t t-call="wt_theme_ecommerce.s_ecommerce_features"/>
            <t t-call="wt_theme_ecommerce.s_ecommerce_showcase"/>
            <t t-call="wt_theme_ecommerce.s_ecommerce_team"/>
            <t t-call="wt_theme_ecommerce.s_ecommerce_testimonials"/>
            <t t-call="wt_theme_ecommerce.s_ecommerce_faq"/>
            <t t-call="wt_theme_ecommerce.s_ecommerce_cta"/>
            <t t-call="wt_theme_ecommerce.s_ecommerce_contact"/>
        </div>
    </xpath>
</template>
</odoo>
