<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_ecommerce_testimonials" name="WT Theme eCommerce Testimonials">
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <span class="wtt-eyebrow">Reviews</span>
                <h2 class="wtt-h2 mt-3">What People Say</h2>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="wtt-quote">
                        <blockquote>"Bought one of their Goodyear-welted derbies four years ago. Re-soled twice, free both times. Will probably outlive me."</blockquote>
                        <cite>Customer</cite>
                        <span class="role">4 yrs</span>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-quote">
                        <blockquote>"Real product photos, real maker stories. Refreshing in 2024."</blockquote>
                        <cite>First-time buyer</cite>
                        <span class="role"></span>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-quote">
                        <blockquote>"I email them and a real person answers in 10 minutes. That's rare these days."</blockquote>
                        <cite>Repeat customer</cite>
                        <span class="role"></span>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
