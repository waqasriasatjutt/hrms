<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_fashion_showcase" name="WT Theme Fashion Showcase">
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <span class="wtt-eyebrow">Lookbook</span>
                <h2 class="wtt-h2 mt-3">Lookbook</h2>
                <p class="wtt-lead mx-auto" style="text-align:center;">Editorial frames from AW26.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="wtt-showcase">
                        <div class="wtt-showcase__visual"><i class="fa fa-circle"/></div>
                        <div class="wtt-showcase__body">
                            <span class="wtt-showcase__cat">Outerwear</span>
                            <h4>Camel Wool Coat</h4>
                            <p>Italian melton wool, hand-pieced collar.</p>
                        </div>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-showcase">
                        <div class="wtt-showcase__visual"><i class="fa fa-square"/></div>
                        <div class="wtt-showcase__body">
                            <span class="wtt-showcase__cat">Eveningwear</span>
                            <h4>Silk Slip Dress</h4>
                            <p>Hand-rolled hem, bias-cut, pure silk.</p>
                        </div>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-showcase">
                        <div class="wtt-showcase__visual"><i class="fa fa-star"/></div>
                        <div class="wtt-showcase__body">
                            <span class="wtt-showcase__cat">Daywear</span>
                            <h4>Wool Trouser</h4>
                            <p>Drape-front, side-tab adjusters.</p>
                        </div>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-showcase">
                        <div class="wtt-showcase__visual"><i class="fa fa-heart"/></div>
                        <div class="wtt-showcase__body">
                            <span class="wtt-showcase__cat">Eveningwear</span>
                            <h4>Cashmere Cape</h4>
                            <p>Hand-woven, over-shoulder length.</p>
                        </div>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-showcase">
                        <div class="wtt-showcase__visual"><i class="fa fa-bookmark"/></div>
                        <div class="wtt-showcase__body">
                            <span class="wtt-showcase__cat">Outerwear</span>
                            <h4>Leather Trench</h4>
                            <p>Vegetable-tanned, hand-stitched seams.</p>
                        </div>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-showcase">
                        <div class="wtt-showcase__visual"><i class="fa fa-trophy"/></div>
                        <div class="wtt-showcase__body">
                            <span class="wtt-showcase__cat">Atelier</span>
                            <h4>Couture Gown</h4>
                            <p>Made-to-measure, 80 hours per piece.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
