<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_fashion_testimonials" name="WT Theme Fashion Testimonials">
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <span class="wtt-eyebrow">Reviews</span>
                <h2 class="wtt-h2 mt-3">What People Say</h2>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="wtt-quote">
                        <blockquote>"The construction of the camel coat is like nothing else at this price. It's couture-grade, not designer-grade."</blockquote>
                        <cite>Editor</cite>
                        <span class="role">fashion magazine</span>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-quote">
                        <blockquote>"They re-tailored a slip dress to fit perfectly, no questions, no charge. That's how they do business."</blockquote>
                        <cite>Bridal client</cite>
                        <span class="role"></span>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-quote">
                        <blockquote>"I bought a blazer in 2019. Still gets compliments. Still fits the same."</blockquote>
                        <cite>Customer</cite>
                        <span class="role">5 yrs</span>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
