<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="homepage" inherit_id="website.homepage" name="WT Theme Fashion Homepage" priority="40">
    <xpath expr="//div[@id='wrap']" position="replace">
        <div id="wrap" class="oe_structure oe_empty">
            <t t-call="wt_theme_fashion.s_fashion_hero"/>
            <t t-call="wt_theme_fashion.s_fashion_services"/>
            <t t-call="wt_theme_fashion.s_fashion_features"/>
            <t t-call="wt_theme_fashion.s_fashion_showcase"/>
            <t t-call="wt_theme_fashion.s_fashion_team"/>
            <t t-call="wt_theme_fashion.s_fashion_testimonials"/>
            <t t-call="wt_theme_fashion.s_fashion_faq"/>
            <t t-call="wt_theme_fashion.s_fashion_cta"/>
            <t t-call="wt_theme_fashion.s_fashion_contact"/>
        </div>
    </xpath>
</template>
</odoo>
