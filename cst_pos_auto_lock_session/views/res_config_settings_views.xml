<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_lock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="after">
                <block title="POS Screen Lock Configuration" id="pos_autolock_section">
                    <setting help="Automatically lock the POS screen after inactivity" string="Inactivity Lock">
                        <field name="auto_lock_enabled"/>
                        <div class="content-group" invisible="not auto_lock_enabled">
                            <div class="row mt16">
                                <label string="Timeout (seconds)" for="auto_lock_time" class="col-lg-5 o_light_label"/>
                                <field name="auto_lock_time" required="auto_lock_enabled" style=""/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>