<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_inherit_pos_guard" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.pos_guard</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="inside">
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="pos_guard_duplicate_zero_payment_line"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_guard_duplicate_zero_payment_line" string="Guard Payment Line with 0 Amount"/>
                            <div class="text-muted">
                                Enable to avoid adding a payment line with 0 amount if one already exists and is not paid.
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
