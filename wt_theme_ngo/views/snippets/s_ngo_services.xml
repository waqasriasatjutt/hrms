<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_ngo_services" name="WT Theme NGO &amp; Nonprofit Services">
    <section id="services" class="py-5" style="background:#FEF7F0;">
        <div class="container">
            <div class="text-center mb-5">
                <span class="wtt-eyebrow">Our Programmes</span>
                <h2 class="wtt-h2 mt-3">Our Programmes</h2>
                <p class="wtt-lead mx-auto" style="text-align:center;">Six programmes. One mission.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-book"/></div>
                        <h3>Education</h3>
                        <p>Building schools, training teachers, providing scholarships in low-income communities.</p>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-medkit"/></div>
                        <h3>Healthcare</h3>
                        <p>Mobile clinics, maternal care, vaccination drives in under-served regions.</p>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-tint"/></div>
                        <h3>Clean Water</h3>
                        <p>Wells, filtration, water management for villages without safe access.</p>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-seedling"/></div>
                        <h3>Food Security</h3>
                        <p>Agricultural training, seed banks, school nutrition programmes.</p>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-female"/></div>
                        <h3>Women &amp; Girls</h3>
                        <p>Microfinance, vocational training, health education for women in poverty.</p>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-globe"/></div>
                        <h3>Climate Action</h3>
                        <p>Tree planting, renewable cooking stoves, climate-resilient farming.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
