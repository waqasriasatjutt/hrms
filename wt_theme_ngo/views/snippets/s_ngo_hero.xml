<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_ngo_hero" name="WT Theme NGO &amp; Nonprofit Hero">
    <section class="wtt-hero">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-7">
                    <span class="wtt-eyebrow mb-3">Since 2012</span>
                    <h1 class="wtt-h1">Small Acts. <span style="color:#EA580C;">Big Change.</span></h1>
                    <p class="wtt-lead">A community-led nonprofit working in 14 countries. 84% of every dollar reaches the field. We publish our books — every quarter, every project, every dollar.</p>
                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <a href="#contact" class="btn btn-lg wtt-btn-primary">Donate Now</a>
                        <a href="#services" class="btn btn-lg wtt-btn-outline">Our Programmes</a>
                    </div>
                    <div class="wtt-hero__stats"><div class="stat"><div class="num">14</div><div class="label">Countries</div></div><div class="stat"><div class="num">48K+</div><div class="label">Lives Touched</div></div><div class="stat"><div class="num">84¢</div><div class="label">Per $1 In Field</div></div></div>
                </div>
                <div class="col-lg-5 d-none d-lg-block">
                    <div class="wtt-hero__visual">
                        <i class="bg-glyph fa fa-circle-o-notch"/>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
