<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="homepage" inherit_id="website.homepage" name="WT Theme NGO &amp; Nonprofit Homepage" priority="40">
    <xpath expr="//div[@id='wrap']" position="replace">
        <div id="wrap" class="oe_structure oe_empty">
            <t t-call="wt_theme_ngo.s_ngo_hero"/>
            <t t-call="wt_theme_ngo.s_ngo_services"/>
            <t t-call="wt_theme_ngo.s_ngo_features"/>
            <t t-call="wt_theme_ngo.s_ngo_showcase"/>
            <t t-call="wt_theme_ngo.s_ngo_team"/>
            <t t-call="wt_theme_ngo.s_ngo_testimonials"/>
            <t t-call="wt_theme_ngo.s_ngo_faq"/>
            <t t-call="wt_theme_ngo.s_ngo_cta"/>
            <t t-call="wt_theme_ngo.s_ngo_contact"/>
        </div>
    </xpath>
</template>
</odoo>
