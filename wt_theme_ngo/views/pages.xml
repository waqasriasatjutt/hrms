<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="page_about" model="website.page">
    <field name="name">About</field>
    <field name="url">/about-us</field>
    <field name="website_indexed" eval="True"/>
    <field name="is_published" eval="True"/>
    <field name="key">wt_theme_ngo.page_about</field>
    <field name="type">qweb</field>
    <field name="arch" type="xml">
        <t name="About" t-name="wt_theme_ngo.page_about">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <section class="wtt-hero" style="padding:5rem 0 3rem;">
                        <div class="container">
                            <span class="wtt-eyebrow mb-3">About</span>
                            <h1 class="wtt-h1">Small Acts. Big Change. Honest Books.</h1>
                        </div>
                    </section>
                    <t t-call="wt_theme_ngo.s_ngo_features"/>
                    <t t-call="wt_theme_ngo.s_ngo_team"/>
                    <t t-call="wt_theme_ngo.s_ngo_testimonials"/>
                    <t t-call="wt_theme_ngo.s_ngo_cta"/>
                </div>
            </t>
        </t>
    </field>
</record>

<record id="page_services" model="website.page">
    <field name="name">Services</field>
    <field name="url">/services</field>
    <field name="website_indexed" eval="True"/>
    <field name="is_published" eval="True"/>
    <field name="key">wt_theme_ngo.page_services</field>
    <field name="type">qweb</field>
    <field name="arch" type="xml">
        <t name="Services" t-name="wt_theme_ngo.page_services">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <section class="wtt-hero" style="padding:5rem 0 3rem;">
                        <div class="container">
                            <span class="wtt-eyebrow mb-3">Our Programmes</span>
                            <h1 class="wtt-h1">Our Programmes</h1>
                        </div>
                    </section>
                    <t t-call="wt_theme_ngo.s_ngo_services"/>
                    <t t-call="wt_theme_ngo.s_ngo_features"/>
                    <t t-call="wt_theme_ngo.s_ngo_cta"/>
                </div>
            </t>
        </t>
    </field>
</record>

<record id="page_showcase" model="website.page">
    <field name="name">Recent Impact</field>
    <field name="url">/impact</field>
    <field name="website_indexed" eval="True"/>
    <field name="is_published" eval="True"/>
    <field name="key">wt_theme_ngo.page_showcase</field>
    <field name="type">qweb</field>
    <field name="arch" type="xml">
        <t name="Recent Impact" t-name="wt_theme_ngo.page_showcase">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <section class="wtt-hero" style="padding:5rem 0 3rem;">
                        <div class="container">
                            <span class="wtt-eyebrow mb-3">Recent Impact</span>
                            <h1 class="wtt-h1">Recent Impact</h1>
                        </div>
                    </section>
                    <t t-call="wt_theme_ngo.s_ngo_showcase"/>
                    <t t-call="wt_theme_ngo.s_ngo_testimonials"/>
                    <t t-call="wt_theme_ngo.s_ngo_cta"/>
                </div>
            </t>
        </t>
    </field>
</record>

<record id="page_contact" model="website.page">
    <field name="name">Contact</field>
    <field name="url">/contact</field>
    <field name="website_indexed" eval="True"/>
    <field name="is_published" eval="True"/>
    <field name="key">wt_theme_ngo.page_contact</field>
    <field name="type">qweb</field>
    <field name="arch" type="xml">
        <t name="Contact" t-name="wt_theme_ngo.page_contact">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <section class="wtt-hero" style="padding:5rem 0 3rem;">
                        <div class="container">
