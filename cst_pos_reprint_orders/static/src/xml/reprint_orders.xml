<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_reprint.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">

        <xpath expr="//div[@class='header-row d-flex text-bg-700 fw-bolder']" position="inside">
            <!-- Only for Adjust the Alignment -->
                <div class="reprint col narrow p-2"></div>
        </xpath>

        <xpath expr="//div[contains(@class,'order-row') and not(contains(@class,'mobileOrderList'))]" position="inside">
            <div class="col narrow p-2 reprint-button" name="reprint"
                 t-on-click.stop="() => this.onReprintOrder(order)">
                <t t-if="!shouldShowPrintIcon(order)">
                    <i class="fa fa-print" aria-hidden="true"/>
                </t>
                <t t-else="">
                    <div class="col very-narrow p-2"></div>
                </t>
            </div>
        </xpath>

        <xpath expr="//div[contains(@class,'mobileOrderList order-row')]" position="inside">
            <div class="col p-2 d-flex justify-content-between align-items-center">
                <div class="reprint-button"
                     t-on-click.stop="() => this.onReprintOrder(order)">
                    <t t-if="!shouldShowPrintIcon(order)">
                        <i class="fa fa-print" aria-hidden="true"/>
                    </t>
                    <t t-else="">
                        <div class="col very-narrow p-2"></div>
                    </t>
                </div>
            </div>
        </xpath>
    </t>
</templates>
