<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="homepage" inherit_id="website.homepage" name="WT Theme Consulting Homepage" priority="40">
    <xpath expr="//div[@id='wrap']" position="replace">
        <div id="wrap" class="oe_structure oe_empty">
            <t t-call="wt_theme_consulting.s_consulting_hero"/>
            <t t-call="wt_theme_consulting.s_consulting_services"/>
            <t t-call="wt_theme_consulting.s_consulting_features"/>
            <t t-call="wt_theme_consulting.s_consulting_showcase"/>
            <t t-call="wt_theme_consulting.s_consulting_team"/>
            <t t-call="wt_theme_consulting.s_consulting_testimonials"/>
            <t t-call="wt_theme_consulting.s_consulting_faq"/>
            <t t-call="wt_theme_consulting.s_consulting_cta"/>
            <t t-call="wt_theme_consulting.s_consulting_contact"/>
        </div>
    </xpath>
</template>
</odoo>
