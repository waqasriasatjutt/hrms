<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="page_about" model="website.page">
    <field name="name">About</field>
    <field name="url">/about-us</field>
    <field name="website_indexed" eval="True"/>
    <field name="is_published" eval="True"/>
    <field name="key">wt_theme_consulting.page_about</field>
    <field name="type">qweb</field>
    <field name="arch" type="xml">
        <t name="About" t-name="wt_theme_consulting.page_about">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <section class="wtt-hero" style="padding:5rem 0 3rem;">
                        <div class="container">
                            <span class="wtt-eyebrow mb-3">About</span>
                            <h1 class="wtt-h1">Senior Consultants. Operating Outcomes.</h1>
                        </div>
                    </section>
                    <t t-call="wt_theme_consulting.s_consulting_features"/>
                    <t t-call="wt_theme_consulting.s_consulting_team"/>
                    <t t-call="wt_theme_consulting.s_consulting_testimonials"/>
                    <t t-call="wt_theme_consulting.s_consulting_cta"/>
                </div>
            </t>
        </t>
    </field>
</record>

<record id="page_services" model="website.page">
    <field name="name">Services</field>
    <field name="url">/services</field>
    <field name="website_indexed" eval="True"/>
    <field name="is_published" eval="True"/>
    <field name="key">wt_theme_consulting.page_services</field>
    <field name="type">qweb</field>
    <field name="arch" type="xml">
        <t name="Services" t-name="wt_theme_consulting.page_services">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <section class="wtt-hero" style="padding:5rem 0 3rem;">
                        <div class="container">
                            <span class="wtt-eyebrow mb-3">What We Do</span>
                            <h1 class="wtt-h1">What We Do</h1>
                        </div>
                    </section>
                    <t t-call="wt_theme_consulting.s_consulting_services"/>
                    <t t-call="wt_theme_consulting.s_consulting_features"/>
                    <t t-call="wt_theme_consulting.s_consulting_cta"/>
                </div>
            </t>
        </t>
    </field>
</record>

