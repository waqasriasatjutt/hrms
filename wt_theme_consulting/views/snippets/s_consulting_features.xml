<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_consulting_features" name="WT Theme Consulting Features">
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <span class="wtt-eyebrow">Why Boards Hire Us</span>
                <h2 class="wtt-h2 mt-3">Why Boards Hire Us</h2>
                <p class="wtt-lead mx-auto" style="text-align:center;">No juniors. No theatre. No surprises.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="wtt-pillar">
                        <div class="icon"><i class="fa fa-user-tie"/></div>
