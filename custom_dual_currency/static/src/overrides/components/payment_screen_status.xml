        <!-- existing remaining + change sections -->
        <xpath expr="//div[contains(@class,'payment-status-remaining')]" position="replace">
            <div class="payment-status-remaining d-flex flex-column flex-grow-1">
                <div class="d-flex justify-content-between">
                    <span class="label pe-2">Remaining (USD)</span>
                    <span class="amount align-self-end pe-5 highlight text-danger fw-bolder">
                        <t t-esc="remainingText.usd" />
                    </span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="label pe-2">Remaining (LBP)</span>
                    <span class="amount align-self-end pe-5 highlight text-danger fw-bolder">
                        <t t-esc="remainingText.lbp" />
                    </span>
                </div>
            </div>
        </xpath>

        <xpath expr="//div[contains(@class,'payment-status-change')]" position="replace">
            <div class="payment-status-change d-flex flex-column flex-grow-1">
                <div class="d-flex justify-content-between">
                    <span class="label pe-2">Change (USD)</span>
                    <span class="amount align-self-end pe-5 highlight text-success fw-bolder">
                        <t t-esc="changeText.usd" />
                    </span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="label pe-2">Change (LBP)</span>
                    <span class="amount align-self-end pe-5 highlight text-success fw-bolder">
                        <t t-esc="changeText.lbp" />
                    </span>
                </div>
            </div>
        </xpath>

    </t>
</templates>
