<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="homepage" inherit_id="website.homepage" name="WT Theme Restaurant Homepage" priority="40">
    <xpath expr="//div[@id='wrap']" position="replace">
        <div id="wrap" class="oe_structure oe_empty">
            <t t-call="wt_theme_restaurant.s_restaurant_hero"/>
            <t t-call="wt_theme_restaurant.s_restaurant_services"/>
            <t t-call="wt_theme_restaurant.s_restaurant_features"/>
            <t t-call="wt_theme_restaurant.s_restaurant_showcase"/>
            <t t-call="wt_theme_restaurant.s_restaurant_team"/>
            <t t-call="wt_theme_restaurant.s_restaurant_testimonials"/>
            <t t-call="wt_theme_restaurant.s_restaurant_faq"/>
            <t t-call="wt_theme_restaurant.s_restaurant_cta"/>
            <t t-call="wt_theme_restaurant.s_restaurant_contact"/>
        </div>
    </xpath>
</template>
</odoo>
