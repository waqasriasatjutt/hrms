<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_restaurant_testimonials" name="WT Theme Restaurant Testimonials">
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <span class="wtt-eyebrow">Reviews</span>
                <h2 class="wtt-h2 mt-3">What People Say</h2>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="wtt-quote">
                        <blockquote>"The wood-fired margherita is the best I've had outside of Naples. We're here three nights a week."</blockquote>
                        <cite>Food critic</cite>
                        <span class="role">local paper</span>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-quote">
                        <blockquote>"They remembered my anniversary table. Two years in a row. That doesn't happen anywhere else."</blockquote>
                        <cite>Regular guest</cite>
                        <span class="role"></span>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-quote">
                        <blockquote>"Pasta literally rolled out in front of you. Worth the trip from anywhere."</blockquote>
                        <cite>Travel blogger</cite>
                        <span class="role"></span>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
