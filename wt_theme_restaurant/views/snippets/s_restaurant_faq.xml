<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_restaurant_faq" name="WT Theme Restaurant FAQ">
    <section class="py-5" style="background:#FFF8F0;">
        <div class="container">
            <div class="text-center mb-5">
                <span class="wtt-eyebrow">FAQ</span>
                <h2 class="wtt-h2 mt-3">Common Questions</h2>
            </div>
            <div class="row justify-content-center">
                <div class="col-lg-9">
                    <div class="wtt-faq accordion" id="wtt_restaurant_faq">
                        <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#wtt_restaurant_faq_0">Do you take reservations?</button>
                </h3>
                <div id="wtt_restaurant_faq_0" class="accordion-collapse collapse show" data-bs-parent="#wtt_restaurant_faq">
                    <div class="accordion-body">Yes — book online, by phone, or walk in (we keep half the bar for walk-ins).</div>
                </div>
            </div><div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#wtt_restaurant_faq_1">Vegetarian / vegan options?</button>
                </h3>
                <div id="wtt_restaurant_faq_1" class="accordion-collapse collapse" data-bs-parent="#wtt_restaurant_faq">
                    <div class="accordion-body">15+ vegetarian dishes, 6 fully vegan. Our pasta is made with eggs, but we have egg-free options too.</div>
                </div>
            </div><div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#wtt_restaurant_faq_2">Private events?</button>
                </h3>
                <div id="wtt_restaurant_faq_2" class="accordion-collapse collapse" data-bs-parent="#wtt_restaurant_faq">
                    <div class="accordion-body">We do full buyouts on Mondays and Tuesdays. Up to 32 seated, 50 standing.</div>
                </div>
            </div><div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#wtt_restaurant_faq_3">Where do you source ingredients?</button>
                </h3>
                <div id="wtt_restaurant_faq_3" class="accordion-collapse collapse" data-bs-parent="#wtt_restaurant_faq">
                    <div class="accordion-body">Our 18-acre organic farm + a network of small Italian importers. Daily delivery.</div>
                </div>
            </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
