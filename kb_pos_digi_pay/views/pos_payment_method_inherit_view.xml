<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_digipay" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.digipay</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field name="is_digipay_test_mode" 
                    groups="base.group_no_one"
                    invisible="use_payment_terminal != 'digi_pay'"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_payment_form_inherit_digipay" model="ir.ui.view">
        <field name="name">view.pos.payment.form.inherit.digipay</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group" position="after">
                <label for="is_digipay" string="Is DigiPay?"/>
                <field name="is_digipay" readonly="1"/>
                <group col="4" string="DigiPay info" invisible="not is_digipay">
                    <field name="digipay_status" readonly="1"/>
                    <field name="digipay_db_ref_no" readonly="1"/>

                    <field name="digipay_resp_code" readonly="1"/>
                    <field name="digipay_terminal_id" readonly="1"/>

                    <field name="digipay_approval_code" readonly="1"/>
                    <field name="digipay_payment_request_id" readonly="1"/>

                    <field name="digipay_rrn" readonly="1"/>
                    <field name="digipay_textresponse" readonly="1" colspan="4"
                        groups="base.group_no_one"/>
                </group>
           </xpath>
        </field>
    </record>

</odoo>
