<odoo>
    <template id="sale_item_summary_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">

                <div class="page">
                    <h2 style="text-align:center; margin-bottom:20px;">POS Item Summary Report</h2>

                    <table style="width:100%; border-collapse: collapse; font-size:13px;">
                        <thead>
                            <tr style="background-color: #b6d7a8; text-align:center;">
                                <th style="border:1px solid black; padding:5px;">S. No</th>
                                <th style="border:1px solid black; padding:5px;">Item Name</th>
                                <th style="border:1px solid black; padding:5px;">Barcode</th>
                                <th style="border:1px solid black; padding:5px;">Date of Sale</th>
                                <th style="border:1px solid black; padding:5px;">Order Ref.</th>
                                <th style="border:1px solid black; padding:5px;">Order No.</th>
                                <th style="border:1px solid black; padding:5px;">Quantity Sold</th>
                                <th style="border:1px solid black; padding:5px;">Cost Price</th>
                                <th style="border:1px solid black; padding:5px;">Sale Price</th>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-set="counter" t-value="1"/>
                            <t t-foreach="docs" t-as="o">
                                <t t-foreach="o.lines" t-as="line">
                                    <tr>
                                        <td style="border:1px solid black; text-align:center;">
                                            <t t-esc="counter"/>
                                        </td>
                                        <td style="border:1px solid black; padding:5px;">
                                            <t t-esc="line.product_id.display_name"/>
                                        </td>
                                        <td style="border:1px solid black; text-align:center;">
                                            <t t-esc="line.product_id.barcode or ''"/>
                                        </td>
                                        <td style="border:1px solid black; text-align:center;">
                                            <span t-field="o.date_order" t-options='{"widget": "date"}'/>
                                        </td>
                                        <td style="border:1px solid black; text-align:center;">
                                            <t t-esc="o.name"/>
                                        </td>
                                        <td style="border:1px solid black; text-align:center;">
                                            <t t-esc="o.tracking_number"/>
                                        </td>
                                        <td style="border:1px solid black; text-align:center;">
                                            <t t-esc="line.qty"/>
                                        </td>
                                        <td style="border:1px solid black; text-align:right;">
                                            <t t-esc="line.product_id.standard_price or 0.0"/>
                                        </td>
                                        <td style="border:1px solid black; text-align:right;">
                                            <t t-esc="line.price_unit"/>
                                        </td>
                                    </tr>
                                    <t t-set="counter" t-value="counter + 1"/>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>

            </t>
        </t>
    </template>
</odoo>
