<!-- Top menu entries -->
<record id="menu_about" model="website.menu">
    <field name="name">About</field>
    <field name="url">/about-us</field>
    <field name="parent_id" search="[('url', '=', '/default-main-menu')]"/>
    <field name="page_id" ref="page_about"/>
    <field name="sequence" type="int">10</field>
</record>
<record id="menu_services" model="website.menu">
    <field name="name">Services</field>
    <field name="url">/services</field>
    <field name="parent_id" search="[('url', '=', '/default-main-menu')]"/>
    <field name="page_id" ref="page_services"/>
    <field name="sequence" type="int">20</field>
</record>
<record id="menu_doctors" model="website.menu">
    <field name="name">Doctors</field>
    <field name="url">/doctors</field>
    <field name="parent_id" search="[('url', '=', '/default-main-menu')]"/>
    <field name="page_id" ref="page_doctors"/>
    <field name="sequence" type="int">30</field>
</record>
<record id="menu_contact" model="website.menu">
    <field name="name">Contact</field>
    <field name="url">/contact</field>
    <field name="parent_id" search="[('url', '=', '/default-main-menu')]"/>
    <field name="page_id" ref="page_contact"/>
    <field name="sequence" type="int">40</field>
</record>

</odoo>
