<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- About -->
<record id="page_about" model="website.page">
    <field name="name">About Us</field>
    <field name="url">/about-us</field>
    <field name="website_indexed" eval="True"/>
    <field name="is_published" eval="True"/>
    <field name="key">wt_theme_clinic.page_about</field>
    <field name="type">qweb</field>
    <field name="arch" type="xml">
        <t name="About Us" t-name="wt_theme_clinic.page_about">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <section class="wtc-hero" style="padding:5rem 0 3rem;">
                        <div class="container">
                            <span class="wtc-eyebrow mb-3">About the Clinic</span>
                            <h1 style="font-weight:800;color:#1E293B;">Healthcare With Heart Since 2008</h1>
                        </div>
                    </section>
                    <t t-call="wt_theme_clinic.s_clinic_features"/>
                    <t t-call="wt_theme_clinic.s_clinic_doctors"/>
                    <t t-call="wt_theme_clinic.s_clinic_stats"/>
                    <t t-call="wt_theme_clinic.s_clinic_appointment"/>
                </div>
            </t>
        </t>
    </field>
</record>

