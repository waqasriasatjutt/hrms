<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="homepage" inherit_id="website.homepage" name="WT Clinic Homepage" priority="40">
    <xpath expr="//div[@id='wrap']" position="replace">
        <div id="wrap" class="oe_structure oe_empty">
            <t t-call="wt_theme_clinic.s_clinic_hero"/>
            <t t-call="wt_theme_clinic.s_clinic_services"/>
            <t t-call="wt_theme_clinic.s_clinic_features"/>
            <t t-call="wt_theme_clinic.s_clinic_doctors"/>
            <t t-call="wt_theme_clinic.s_clinic_stats"/>
            <t t-call="wt_theme_clinic.s_clinic_appointment"/>
            <t t-call="wt_theme_clinic.s_clinic_testimonials"/>
            <t t-call="wt_theme_clinic.s_clinic_faq"/>
            <t t-call="wt_theme_clinic.s_clinic_contact"/>
        </div>
    </xpath>
</template>

</odoo>
