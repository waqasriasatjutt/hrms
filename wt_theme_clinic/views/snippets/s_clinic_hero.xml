<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_clinic_hero" name="Clinic Hero">
    <section class="wtc-hero">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-7">
                    <span class="wtc-eyebrow mb-3">Trusted Healthcare Since 2008</span>
                    <h1>Your Health. <span style="color:#00A8A8;">Our Priority.</span></h1>
                    <p class="lead">Compassionate, expert care delivered by a team of board-certified specialists. Same-day appointments, transparent pricing, and a clinic designed to feel like a sanctuary — not a waiting room.</p>
                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <a href="#" class="btn btn-lg"
                           style="background:#00A8A8;color:#fff;border-radius:50rem;font-weight:700;padding:.85rem 2rem;border:none;">
                            <i class="fa fa-calendar-check-o me-2"/> Book Appointment
                        </a>
                        <a href="tel:+15550100420" class="btn btn-lg btn-outline-secondary"
                           style="border-radius:50rem;border-color:#0066CC;color:#0066CC;font-weight:700;padding:.85rem 2rem;">
                            <i class="fa fa-phone me-2"/> Call Us
                        </a>
                    </div>
                    <div class="wtc-hero__stats">
                        <div class="stat">
                            <div class="num">15K+</div>
                            <div class="label">Happy Patients</div>
                        </div>
                        <div class="stat">
                            <div class="num">17</div>
                            <div class="label">Specialists</div>
                        </div>
                        <div class="stat">
                            <div class="num">98%</div>
                            <div class="label">Satisfaction</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5 d-none d-lg-block">
                    <div style="position:relative; aspect-ratio: 4/5; border-radius: 1.5rem; overflow:hidden; background:linear-gradient(135deg,#00A8A8,#0066CC);">
                        <div style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; color:#fff; font-size:8rem;">
                            <i class="fa fa-stethoscope" style="opacity:.4;"/>
                        </div>
                        <div style="position:absolute; bottom:1.5rem; left:1.5rem; right:1.5rem; background:rgba(255,255,255,.95); padding:1.25rem; border-radius:1rem;">
                            <div style="font-size:.8rem;color:#0066CC;text-transform:uppercase;letter-spacing:.12em;font-weight:700;">Open Today</div>
                            <div style="font-size:1.25rem;color:#1E293B;font-weight:800;">8:00 AM — 9:00 PM</div>
                            <div style="font-size:.85rem;color:#64748B;margin-top:.25rem;">Walk-ins welcome · Insurance accepted</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>

</odoo>
