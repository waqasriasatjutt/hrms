<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_clinic_contact" name="Clinic Contact">
    <section class="py-5" style="background:#F0F9FF;">
        <div class="container">
            <div class="text-center mb-5">
                <span class="wtc-eyebrow">Visit Us</span>
                <h2 class="mt-3" style="font-weight:800;color:#1E293B;">We're Easy To Find &amp; Easier To Talk To</h2>
            </div>
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="wtc-contact-card">
                        <h3 style="font-weight:800;color:#1E293B;margin-bottom:1.5rem;">Clinic Information</h3>
                        <div class="row align-items-center">
                            <div class="col-auto"><div class="icon"><i class="fa fa-map-marker"/></div></div>
                            <div class="col">
                                <h5>Address</h5>
                                <p>118 Wellness Boulevard, Suite 4B<br/>Medical District 51000</p>
                            </div>
                        </div>
                        <div class="row align-items-center">
                            <div class="col-auto"><div class="icon"><i class="fa fa-phone"/></div></div>
                            <div class="col">
                                <h5>Phone</h5>
                                <p>+1 555 010 0420 (24/7 emergency)</p>
                            </div>
                        </div>
                        <div class="row align-items-center">
                            <div class="col-auto"><div class="icon"><i class="fa fa-envelope"/></div></div>
                            <div class="col">
                                <h5>Email</h5>
                                <p>care@your-clinic.com</p>
                            </div>
                        </div>
                        <div class="row align-items-center">
                            <div class="col-auto"><div class="icon"><i class="fa fa-clock-o"/></div></div>
                            <div class="col">
                                <h5>Hours</h5>
                                <p>Mon–Sat 8:00 AM – 9:00 PM<br/>Sun 9:00 AM – 5:00 PM</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="wtc-contact-card">
                        <h3 style="font-weight:800;color:#1E293B;margin-bottom:1.5rem;">Send Us A Message</h3>
                        <form action="/website_form/" method="post" enctype="multipart/form-data"
                              class="o_mark_required" data-mark="*"
                              data-model_name="mail.mail" data-success-mode="redirect"
                              data-success-page="/contactus-thank-you">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold" for="contact_name">Full Name *</label>
                                    <input type="text" class="form-control"
                                           name="name" id="contact_name" required="required"
                                           style="border-radius:.75rem;border:1px solid #E5E7EB;padding:.75rem 1rem;"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold" for="contact_phone">Phone *</label>
                                    <input type="tel" class="form-control"
                                           name="phone" id="contact_phone" required="required"
                                           style="border-radius:.75rem;border:1px solid #E5E7EB;padding:.75rem 1rem;"/>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-bold" for="contact_email">Email *</label>
                                    <input type="email" class="form-control"
                                           name="email_from" id="contact_email" required="required"
                                           style="border-radius:.75rem;border:1px solid #E5E7EB;padding:.75rem 1rem;"/>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-bold" for="contact_dept">Department</label>
                                    <select class="form-select" name="subject" id="contact_dept"
                                            style="border-radius:.75rem;border:1px solid #E5E7EB;padding:.75rem 1rem;">
                                        <option>Cardiology</option>
                                        <option>Pediatrics</option>
                                        <option>Dental</option>
                                        <option>Ophthalmology</option>
                                        <option>Gynaecology</option>
                                        <option>Lab &amp; Diagnostics</option>
                                        <option>General Enquiry</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-bold" for="contact_msg">Message</label>
                                    <textarea class="form-control"
                                              name="description" id="contact_msg" rows="4"
                                              style="border-radius:.75rem;border:1px solid #E5E7EB;padding:.75rem 1rem;"/>
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn"
                                            style="background:#00A8A8;color:#fff;border-radius:50rem;font-weight:700;padding:.85rem 2.25rem;border:none;width:100%;">
                                        Send Message
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>

</odoo>
