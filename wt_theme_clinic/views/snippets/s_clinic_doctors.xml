<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_clinic_doctors" name="Clinic Doctors">
    <section class="py-5">
        <div class="container">
            <div class="d-flex flex-wrap justify-content-between align-items-end mb-5">
                <div>
                    <span class="wtc-eyebrow">Meet The Team</span>
                    <h2 class="mt-3" style="font-weight:800;color:#1E293B;">Specialists You Can Trust</h2>
                </div>
                <a href="#" class="btn btn-outline-primary"
                   style="border-radius:50rem;padding:.7rem 1.5rem;font-weight:700;border-color:#00A8A8;color:#00A8A8;">
                    See All Doctors
                </a>
            </div>
            <div class="row g-4">
                <div class="col-sm-6 col-lg-3">
                    <div class="wtc-doctor">
                        <div class="wtc-doctor__photo">
                            <img src="/web/image/website.s_team_default_image_1"
                                 onerror="this.style.display='none'"
                                 alt="Dr. Sarah Chen"/>
                            <span class="wtc-doctor__badge">Cardiology</span>
                        </div>
                        <div class="wtc-doctor__body">
                            <h4>Dr. Sarah Chen</h4>
                            <div class="role">Senior Cardiologist</div>
                            <p class="creds">MBBS, MD, FACC · 18 yrs exp.</p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="wtc-doctor">
                        <div class="wtc-doctor__photo">
                            <img src="/web/image/website.s_team_default_image_2"
                                 onerror="this.style.display='none'"
                                 alt="Dr. James Akhter"/>
                            <span class="wtc-doctor__badge">Pediatrics</span>
                        </div>
                        <div class="wtc-doctor__body">
                            <h4>Dr. James Akhter</h4>
                            <div class="role">Consultant Paediatrician</div>
                            <p class="creds">MBBS, FCPS Paeds · 14 yrs exp.</p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="wtc-doctor">
                        <div class="wtc-doctor__photo">
                            <img src="/web/image/website.s_team_default_image_3"
                                 onerror="this.style.display='none'"
                                 alt="Dr. Priya Raman"/>
                            <span class="wtc-doctor__badge">Dental</span>
                        </div>
                        <div class="wtc-doctor__body">
                            <h4>Dr. Priya Raman</h4>
                            <div class="role">Cosmetic Dentist</div>
                            <p class="creds">BDS, MDS Prosthodontics · 11 yrs exp.</p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="wtc-doctor">
                        <div class="wtc-doctor__photo">
                            <img src="/web/image/website.s_team_default_image_4"
                                 onerror="this.style.display='none'"
                                 alt="Dr. Lisa Hoffman"/>
                            <span class="wtc-doctor__badge">Gynae</span>
                        </div>
                        <div class="wtc-doctor__body">
                            <h4>Dr. Lisa Hoffman</h4>
                            <div class="role">Senior Gynaecologist</div>
                            <p class="creds">MBBS, FCPS Obs/Gyn · 16 yrs exp.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>

</odoo>
