<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_clinic_faq" name="Clinic FAQ">
    <section class="py-5">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-5">
                    <span class="wtc-eyebrow">Common Questions</span>
                    <h2 class="mt-3" style="font-weight:800;color:#1E293B;">Answers Before You Even Ask</h2>
                    <p class="text-muted lead">Don't see your question? Call us — we'll talk you through it before you book.</p>
                    <a href="#" class="btn"
                       style="background:#00A8A8;color:#fff;border-radius:50rem;font-weight:700;padding:.75rem 1.75rem;border:none;">
                        Ask A Doctor
                    </a>
                </div>
                <div class="col-lg-7">
                    <div class="wtc-faq accordion" id="wtcFaqAccordion">
                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#wtcFaq1">
                                    Do I need a referral to book an appointment?
                                </button>
                            </h3>
                            <div id="wtcFaq1" class="accordion-collapse collapse show"
                                 data-bs-parent="#wtcFaqAccordion">
                                <div class="accordion-body">
                                    No referral required. You can book directly with any of our specialists online or by phone.
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#wtcFaq2">
                                    Do you accept insurance?
                                </button>
                            </h3>
                            <div id="wtcFaq2" class="accordion-collapse collapse"
                                 data-bs-parent="#wtcFaqAccordion">
                                <div class="accordion-body">
                                    Yes — we accept all major insurance plans. Our front-desk team will verify your coverage before your visit so there are no surprises.
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#wtcFaq3">
                                    Are same-day appointments possible?
                                </button>
                            </h3>
                            <div id="wtcFaq3" class="accordion-collapse collapse"
                                 data-bs-parent="#wtcFaqAccordion">
                                <div class="accordion-body">
                                    Same-day slots open up daily as patients confirm. Call us before 11 AM and we'll usually fit you in by evening.
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#wtcFaq4">
                                    Do you have on-site lab and imaging?
                                </button>
                            </h3>
                            <div id="wtcFaq4" class="accordion-collapse collapse"
                                 data-bs-parent="#wtcFaqAccordion">
                                <div class="accordion-body">
                                    Yes — full pathology lab, X-ray, ultrasound, and ECG on-site. MRI / CT we refer to a partner imaging centre, results integrated into your patient file.
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#wtcFaq5">
                                    Is there parking at the clinic?
                                </button>
                            </h3>
                            <div id="wtcFaq5" class="accordion-collapse collapse"
                                 data-bs-parent="#wtcFaqAccordion">
                                <div class="accordion-body">
                                    Free patient parking on-site, including 4 accessible bays right at the front entrance.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>

</odoo>
