<?xml version="1.0"?>
<odoo>
    <data>
        <record id="view_pos_payway_configuration_form" model="ir.ui.view" >
            <field name="name">Payway credenciales</field>
            <field name="model">pos_payway.configuration</field>
            <field name="arch" type="xml">
                <form string="Card Reader">
                    <sheet>
                        <div class="oe_title">
                           <label for="name"/>
                           <h1><field name="name"/></h1>
                        </div>
                        <group col="2">
                            <field name="payway_acquier_id"/>
                            <field name="payway_secret_basic"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_pos_payway_configuration_tree" model="ir.ui.view">
            <field name="name">Payway credenciales</field>
            <field name="model">pos_payway.configuration</field>
            <field name="arch" type="xml">
                <list string="Card Reader">
                    <field name="name"/>
                    <field name="payway_acquier_id"/>
                    <field name="company_id" readonly="1"/>
                </list>
            </field>
        </record>

        <record id="action_configuration_form" model="ir.actions.act_window">
            <field name="name">Payway credenciales</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">pos_payway.configuration</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_payway_credential_config" parent="point_of_sale.menu_point_config_product" name='Payway' groups="base.group_no_one" sequence="35"/>
        <menuitem parent="pos_payway.menu_payway_credential_config" action="pos_payway.action_configuration_form" id="menu_pos_pos_payway_config" groups="base.group_no_one" sequence="36"/>
    </data>
</odoo>
