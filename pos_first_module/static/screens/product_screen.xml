            <div style="min-width: fit-content;text-align: center;font-size: large;font-weight: bold;background: #ff542a;color: black;">
                <div style="overflow: hidden; white-space: nowrap;">
                    <p style="
                        display: inline-block;
                        margin-top: 10%;
                        padding: 5px;
                        animation: marquee 5s linear infinite;
                        font-weight: bold;
                    ">
                        🙏NOORINA🙏
                    </p>
                </div>
                <style>
                    @keyframes marquee {
                        0%   { transform: translateX(100%); }
