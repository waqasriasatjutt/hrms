<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Inherit res.config.settings and added field. #T6479 -->
    <record
        id="pos_order_details_res_config_settings_view_form_inherit"
        model="ir.ui.view"
    >
        <field name="name">
            pos.order.details.res.config.settings.view.form.inherit
        </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="pos_order_detail_button" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="pos_order_detail_button" />
                        <div class="text-muted">View details of order.</div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
