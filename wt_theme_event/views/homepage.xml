<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="homepage" inherit_id="website.homepage" name="WT Theme Events Homepage" priority="40">
    <xpath expr="//div[@id='wrap']" position="replace">
        <div id="wrap" class="oe_structure oe_empty">
            <t t-call="wt_theme_event.s_event_hero"/>
            <t t-call="wt_theme_event.s_event_services"/>
            <t t-call="wt_theme_event.s_event_features"/>
            <t t-call="wt_theme_event.s_event_showcase"/>
            <t t-call="wt_theme_event.s_event_team"/>
            <t t-call="wt_theme_event.s_event_testimonials"/>
            <t t-call="wt_theme_event.s_event_faq"/>
            <t t-call="wt_theme_event.s_event_cta"/>
            <t t-call="wt_theme_event.s_event_contact"/>
        </div>
    </xpath>
</template>
</odoo>
