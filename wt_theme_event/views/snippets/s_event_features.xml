<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_event_features" name="WT Theme Events Features">
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <span class="wtt-eyebrow">Why You'll Come Back</span>
                <h2 class="wtt-h2 mt-3">Why You'll Come Back</h2>
                <p class="wtt-lead mx-auto" style="text-align:center;">Curated. Crowded. Caffeinated.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="wtt-pillar">
                        <div class="icon"><i class="fa fa-star"/></div>
                        <h4>Speakers Who Ship</h4>
                        <p>Founders + senior practitioners only. No "thought leaders."</p>
                    </div>
                </div><div class="col-md-6 col-lg-3">
                    <div class="wtt-pillar">
                        <div class="icon"><i class="fa fa-handshake-o"/></div>
                        <h4>Matchmaking</h4>
                        <p>In-app + in-person 1-on-1 matchmaking. Median: 14 conversations per attendee.</p>
                    </div>
                </div><div class="col-md-6 col-lg-3">
                    <div class="wtt-pillar">
                        <div class="icon"><i class="fa fa-microphone"/></div>
                        <h4>No Sales Pitches</h4>
                        <p>Sponsor demos confined to hallways. Talks are practitioner content only.</p>
                    </div>
                </div><div class="col-md-6 col-lg-3">
                    <div class="wtt-pillar">
                        <div class="icon"><i class="fa fa-globe"/></div>
                        <h4>Hybrid Streaming</h4>
                        <p>Couldn't make it? Full talks streamed live + on-demand 30 days. One ticket, both options.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
