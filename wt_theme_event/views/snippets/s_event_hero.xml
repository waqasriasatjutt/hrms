<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_event_hero" name="WT Theme Events Hero">
    <section class="wtt-hero">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-7">
                    <span class="wtt-eyebrow mb-3">Sept 12-14, 2026 · Berlin</span>
                    <h1 class="wtt-h1">Where Builders <span style="color:#7C3AED;">Meet.</span></h1>
                    <p class="wtt-lead">Three days. 60 speakers. 1,200 attendees. The annual gathering for product, design and engineering — minus the sponsor pitches and the fluff.</p>
                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <a href="#contact" class="btn btn-lg wtt-btn-primary">Get Tickets</a>
                        <a href="#services" class="btn btn-lg wtt-btn-outline">See Schedule</a>
                    </div>
                    <div class="wtt-hero__stats"><div class="stat"><div class="num">1.2K+</div><div class="label">Attendees</div></div><div class="stat"><div class="num">60</div><div class="label">Speakers</div></div><div class="stat"><div class="num">3</div><div class="label">Days</div></div></div>
                </div>
                <div class="col-lg-5 d-none d-lg-block">
                    <div class="wtt-hero__visual">
                        <i class="bg-glyph fa fa-circle-o-notch"/>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
