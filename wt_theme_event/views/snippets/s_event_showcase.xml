<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_event_showcase" name="WT Theme Events Showcase">
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <span class="wtt-eyebrow">Schedule</span>
                <h2 class="wtt-h2 mt-3">Schedule</h2>
                <p class="wtt-lead mx-auto" style="text-align:center;">Day-by-day at a glance.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="wtt-showcase">
                        <div class="wtt-showcase__visual"><i class="fa fa-circle"/></div>
                        <div class="wtt-showcase__body">
                            <span class="wtt-showcase__cat">Day 1 · Sep 12</span>
                            <h4>Founder Day</h4>
                            <p>Keynotes from sale-side founders. After-party on the rooftop.</p>
                        </div>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-showcase">
                        <div class="wtt-showcase__visual"><i class="fa fa-square"/></div>
                        <div class="wtt-showcase__body">
                            <span class="wtt-showcase__cat">Day 2 · Sep 13</span>
                            <h4>Builder Day</h4>
                            <p>Workshops + live builds. Sponsor showcase by appointment.</p>
                        </div>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-showcase">
                        <div class="wtt-showcase__visual"><i class="fa fa-star"/></div>
                        <div class="wtt-showcase__body">
                            <span class="wtt-showcase__cat">Day 3 · Sep 14</span>
                            <h4>Outcomes Day</h4>
                            <p>Track talks + builder awards + closing dinner.</p>
                        </div>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-showcase">
                        <div class="wtt-showcase__visual"><i class="fa fa-heart"/></div>
                        <div class="wtt-showcase__body">
                            <span class="wtt-showcase__cat">Pre-Conf · Sep 11</span>
                            <h4>Workshops</h4>
                            <p>Optional paid workshops, all caps at 24.</p>
                        </div>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-showcase">
                        <div class="wtt-showcase__visual"><i class="fa fa-bookmark"/></div>
                        <div class="wtt-showcase__body">
                            <span class="wtt-showcase__cat">Side Events</span>
                            <h4>Sep 11-15</h4>
                            <p>Crew-organised side events around the city.</p>
                        </div>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-showcase">
                        <div class="wtt-showcase__visual"><i class="fa fa-trophy"/></div>
                        <div class="wtt-showcase__body">
                            <span class="wtt-showcase__cat">Online</span>
                            <h4>Sep 12-14</h4>
                            <p>Hybrid livestream + on-demand for 30 days.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
