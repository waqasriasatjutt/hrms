            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <section class="wtt-hero" style="padding:5rem 0 3rem;">
                        <div class="container">
                            <span class="wtt-eyebrow mb-3">Service Menu</span>
                            <h1 class="wtt-h1">Service Menu</h1>
                        </div>
                    </section>
                    <t t-call="wt_theme_salon.s_salon_services"/>
                    <t t-call="wt_theme_salon.s_salon_features"/>
                    <t t-call="wt_theme_salon.s_salon_cta"/>
                </div>
            </t>
        </t>
    </field>
</record>

