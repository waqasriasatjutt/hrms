<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="homepage" inherit_id="website.homepage" name="WT Theme Photography Homepage" priority="40">
    <xpath expr="//div[@id='wrap']" position="replace">
        <div id="wrap" class="oe_structure oe_empty">
            <t t-call="wt_theme_photography.s_photography_hero"/>
            <t t-call="wt_theme_photography.s_photography_services"/>
            <t t-call="wt_theme_photography.s_photography_features"/>
            <t t-call="wt_theme_photography.s_photography_showcase"/>
            <t t-call="wt_theme_photography.s_photography_team"/>
            <t t-call="wt_theme_photography.s_photography_testimonials"/>
            <t t-call="wt_theme_photography.s_photography_faq"/>
            <t t-call="wt_theme_photography.s_photography_cta"/>
            <t t-call="wt_theme_photography.s_photography_contact"/>
        </div>
    </xpath>
</template>
</odoo>
