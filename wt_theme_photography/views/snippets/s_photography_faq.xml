<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_photography_faq" name="WT Theme Photography FAQ">
    <section class="py-5" style="background:#F5F5F5;">
        <div class="container">
            <div class="text-center mb-5">
                <span class="wtt-eyebrow">FAQ</span>
                <h2 class="wtt-h2 mt-3">Common Questions</h2>
            </div>
            <div class="row justify-content-center">
                <div class="col-lg-9">
                    <div class="wtt-faq accordion" id="wtt_photography_faq">
                        <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#wtt_photography_faq_0">Do you travel?</button>
                </h3>
                <div id="wtt_photography_faq_0" class="accordion-collapse collapse show" data-bs-parent="#wtt_photography_faq">
                    <div class="accordion-body">Yes — global. Travel budgeted at cost, no markup.</div>
                </div>
            </div><div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#wtt_photography_faq_1">Turnaround?</button>
                </h3>
                <div id="wtt_photography_faq_1" class="accordion-collapse collapse" data-bs-parent="#wtt_photography_faq">
                    <div class="accordion-body">Sneak peeks 48-72 hours. Full gallery 3 weeks. Albums 6-8 weeks.</div>
                </div>
            </div><div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#wtt_photography_faq_2">Editing style?</button>
                </h3>
                <div id="wtt_photography_faq_2" class="accordion-collapse collapse" data-bs-parent="#wtt_photography_faq">
                    <div class="accordion-body">Documentary-leaning. True-to-light. We don't over-stylise — clients say "they made it look exactly like it felt."</div>
                </div>
            </div><div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#wtt_photography_faq_3">Backup?</button>
                </h3>
                <div id="wtt_photography_faq_3" class="accordion-collapse collapse" data-bs-parent="#wtt_photography_faq">
                    <div class="accordion-body">Dual-card cameras, redundant on-shoot backup, 3-2-1 backup strategy post-shoot. Never lost a frame.</div>
                </div>
            </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
