<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_photography_hero" name="WT Theme Photography Hero">
    <section class="wtt-hero">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-7">
                    <span class="wtt-eyebrow mb-3">Visual Storyteller</span>
                    <h1 class="wtt-h1">Light. Frame. <span style="color:#000000;">Story.</span></h1>
                    <p class="wtt-lead">Documentary-style photography for weddings, brands, and editorial. Quiet on shoot, loud in the gallery. Available worldwide.</p>
                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <a href="#contact" class="btn btn-lg wtt-btn-primary">View Portfolio</a>
                        <a href="#services" class="btn btn-lg wtt-btn-outline">Book A Session</a>
                    </div>
                    <div class="wtt-hero__stats"><div class="stat"><div class="num">120+</div><div class="label">Stories Captured</div></div><div class="stat"><div class="num">14</div><div class="label">Years Shooting</div></div><div class="stat"><div class="num">22</div><div class="label">Countries</div></div></div>
                </div>
                <div class="col-lg-5 d-none d-lg-block">
                    <div class="wtt-hero__visual">
                        <i class="bg-glyph fa fa-circle-o-notch"/>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
