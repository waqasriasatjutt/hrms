<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_photography_showcase" name="WT Theme Photography Showcase">
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <span class="wtt-eyebrow">Recent Work</span>
                <h2 class="wtt-h2 mt-3">Recent Work</h2>
                <p class="wtt-lead mx-auto" style="text-align:center;">A small gallery from the past 12 months.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="wtt-showcase">
                        <div class="wtt-showcase__visual"><i class="fa fa-circle"/></div>
                        <div class="wtt-showcase__body">
                            <span class="wtt-showcase__cat">Wedding</span>
                            <h4>Tuscany Wedding</h4>
                            <p>Quiet villa wedding, 60 guests, gold hour ceremony.</p>
                        </div>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-showcase">
                        <div class="wtt-showcase__visual"><i class="fa fa-square"/></div>
                        <div class="wtt-showcase__body">
                            <span class="wtt-showcase__cat">Brand</span>
                            <h4>Heritage Tequila Campaign</h4>
                            <p>12-frame campaign shot on location in Jalisco.</p>
                        </div>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-showcase">
                        <div class="wtt-showcase__visual"><i class="fa fa-star"/></div>
                        <div class="wtt-showcase__body">
                            <span class="wtt-showcase__cat">Editorial</span>
                            <h4>Profile In TIME</h4>
                            <p>Portrait commission for TIME Magazine.</p>
                        </div>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-showcase">
                        <div class="wtt-showcase__visual"><i class="fa fa-heart"/></div>
                        <div class="wtt-showcase__body">
                            <span class="wtt-showcase__cat">Travel</span>
                            <h4>Iceland Long Essay</h4>
                            <p>24-image essay on glacial caves of southern Iceland.</p>
                        </div>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-showcase">
                        <div class="wtt-showcase__visual"><i class="fa fa-bookmark"/></div>
                        <div class="wtt-showcase__body">
                            <span class="wtt-showcase__cat">Wedding</span>
                            <h4>Mountain Elopement</h4>
                            <p>Two-people elopement at 3,400 m in Patagonia.</p>
                        </div>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-showcase">
                        <div class="wtt-showcase__visual"><i class="fa fa-trophy"/></div>
                        <div class="wtt-showcase__body">
                            <span class="wtt-showcase__cat">Brand</span>
                            <h4>Hotel Group Campaign</h4>
                            <p>Brand refresh for boutique hotel group, 80+ images delivered.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
