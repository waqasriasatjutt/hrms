<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_photography_services" name="WT Theme Photography Services">
    <section id="services" class="py-5" style="background:#F5F5F5;">
        <div class="container">
            <div class="text-center mb-5">
                <span class="wtt-eyebrow">Categories</span>
                <h2 class="wtt-h2 mt-3">Categories</h2>
                <p class="wtt-lead mx-auto" style="text-align:center;">Six bodies of work.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-heart"/></div>
                        <h3>Weddings</h3>
                        <p>Destination + at-home weddings. Two-photographer coverage by default.</p>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-camera"/></div>
                        <h3>Portrait</h3>
                        <p>Editorial-style personal portraits, headshots, family. Studio + on-location.</p>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-bullhorn"/></div>
                        <h3>Brand Campaigns</h3>
                        <p>Visual campaigns for fashion, hospitality, lifestyle brands. Concept to delivery.</p>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-newspaper-o"/></div>
                        <h3>Editorial</h3>
                        <p>Magazine commissions, profile features, long-form photo essays.</p>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-leaf"/></div>
                        <h3>Travel</h3>
                        <p>Long-form travel essays + commissioned tourism boards.</p>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-film"/></div>
                        <h3>Motion</h3>
                        <p>30-90s films, documentary cuts, behind-the-scenes for brands.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
