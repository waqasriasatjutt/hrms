<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="wt_pharmacy_pos.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='props.showRemainingButtons']/div/OrderlineNoteButton" position="after">
            <button class="o_pricelist_button btn btn-secondary btn-lg py-5" t-on-click="() => this.clickPrescriptions()">
                <i class="fa fa-file-text-o me-2" role="img" aria-label="Price list" title="Price list"/>
                Prescriptions
            </button>
        </xpath>
    </t>
</templates>