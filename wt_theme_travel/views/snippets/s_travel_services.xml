<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_travel_services" name="WT Theme Travel &amp; Tours Services">
    <section id="services" class="py-5" style="background:#F0FDFA;">
        <div class="container">
            <div class="text-center mb-5">
                <span class="wtt-eyebrow">Trip Styles</span>
                <h2 class="wtt-h2 mt-3">Trip Styles</h2>
                <p class="wtt-lead mx-auto" style="text-align:center;">Six ways to travel, all hand-curated.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-mountain"/></div>
                        <h3>Adventure</h3>
                        <p>Trekking, climbing, expeditions — guided by certified mountain leaders only.</p>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-sun"/></div>
                        <h3>Beach Escapes</h3>
                        <p>Maldives, Seychelles, Caribbean — water villas to private cabanas, with local guides.</p>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-utensils"/></div>
                        <h3>Culinary</h3>
                        <p>Truffle hunting in Italy, ramen in Tokyo, asado in Argentina — eat the country.</p>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-camera"/></div>
                        <h3>Wildlife &amp; Safari</h3>
                        <p>East Africa, Patagonia, Galapagos. Conservation-first lodges, no touristy tracks.</p>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-heart"/></div>
                        <h3>Honeymoon</h3>
                        <p>Privacy, drama, magic. Only operators we'd send our own family to.</p>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-passport"/></div>
                        <h3>Long-Haul Tours</h3>
                        <p>Multi-country itineraries with private guide and driver — Asia, Europe, Latin America.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
