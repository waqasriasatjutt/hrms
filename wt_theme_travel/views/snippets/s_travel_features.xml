<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_travel_features" name="WT Theme Travel &amp; Tours Features">
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <span class="wtt-eyebrow">Why Travellers Pick Us</span>
                <h2 class="wtt-h2 mt-3">Why Travellers Pick Us</h2>
                <p class="wtt-lead mx-auto" style="text-align:center;">Not Another Aggregator.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="wtt-pillar">
                        <div class="icon"><i class="fa fa-handshake-o"/></div>
                        <h4>Local Fixers</h4>
                        <p>Real people on the ground in every destination. We've actually been everywhere we sell.</p>
                    </div>
                </div><div class="col-md-6 col-lg-3">
                    <div class="wtt-pillar">
                        <div class="icon"><i class="fa fa-clock-o"/></div>
                        <h4>24/7 On Trip</h4>
                        <p>One number, real human, always answers. Lost passport? Bumped flight? Sorted.</p>
                    </div>
                </div><div class="col-md-6 col-lg-3">
                    <div class="wtt-pillar">
                        <div class="icon"><i class="fa fa-trophy"/></div>
                        <h4>Curated, Not Listed</h4>
                        <p>We turn down 70% of hotels we audit. If it's on our site, we'd sleep there ourselves.</p>
                    </div>
                </div><div class="col-md-6 col-lg-3">
                    <div class="wtt-pillar">
                        <div class="icon"><i class="fa fa-money"/></div>
                        <h4>Honest Pricing</h4>
                        <p>No hidden upgrade fees. Final price quoted is the final price. Including local taxes.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
