<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="sensible_restaurant_access_rights_employee.ActionpadWidget"
       t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">

        <!-- Original pay-order-button (has 'pay' class): use JS getter for visibility -->
        <xpath expr="//button[hasclass('pay') and hasclass('pay-order-button')]" position="attributes">
            <attribute name="t-if">sblShowOriginalPayButton</attribute>
        </xpath>

        <!-- Restaurant's Payment button (inside flex div): use JS getter for visibility -->
        <xpath expr="//div[hasclass('d-flex') and hasclass('flex-fill')]//button[hasclass('pay-order-button')]" position="attributes">
            <attribute name="t-if">sblShowRestaurantPayButton</attribute>
        </xpath>

        <!-- Hide Order button based on employee setting -->
        <xpath expr="//button[hasclass('submit-order')]" position="attributes">
            <attribute name="t-if">!sblHideOrderButton</attribute>
        </xpath>

    </t>
</templates>
