<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="sensible_pos_access_rights_employee.ControlButtons" t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='props.onClickMore']" position="attributes">
            <attribute name="t-if">!pos.user.hide_pos_actions_button and !props.showRemainingButtons and !ui.isSmall and props.onClickMore</attribute>
        </xpath>
    </t>
    <t t-name="sensible_pos_access_rights_employee.Numpad" t-inherit="point_of_sale.Numpad" t-inherit-mode="extension">
        <xpath expr="//div[contains(@t-attf-class,'numpad')]" position="attributes">
            <attribute name="t-if">!pos.user.hide_pos_numpad</attribute>
        </xpath>
    </t>
</templates>