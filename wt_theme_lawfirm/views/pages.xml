                        <div class="container">
                            <span class="wtt-eyebrow mb-3">Recent Wins</span>
                            <h1 class="wtt-h1">Recent Wins</h1>
                        </div>
                    </section>
                    <t t-call="wt_theme_lawfirm.s_lawfirm_showcase"/>
