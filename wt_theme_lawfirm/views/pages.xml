<record id="page_contact" model="website.page">
    <field name="name">Contact</field>
    <field name="url">/contact</field>
    <field name="website_indexed" eval="True"/>
    <field name="is_published" eval="True"/>
    <field name="key">wt_theme_lawfirm.page_contact</field>
    <field name="type">qweb</field>
    <field name="arch" type="xml">
        <t name="Contact" t-name="wt_theme_lawfirm.page_contact">
