<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_lawfirm_hero" name="WT Theme Law Firm Hero">
    <section class="wtt-hero">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-7">
                    <span class="wtt-eyebrow mb-3">Trusted Counsel Since 1998</span>
                    <h1 class="wtt-h1">Justice Demands <span style="color:#B8860B;">Excellence.</span></h1>
                    <p class="wtt-lead">A boutique firm of senior advocates with 25+ years of courtroom experience. We take fewer cases. We win more of them.</p>
