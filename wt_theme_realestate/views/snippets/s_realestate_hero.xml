<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_realestate_hero" name="WT Theme Real Estate Hero">
    <section class="wtt-hero">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-7">
                    <span class="wtt-eyebrow mb-3">Trusted Brokers Since 2010</span>
                    <h1 class="wtt-h1">Find The Home That <span style="color:#1E3A8A;">Finds You.</span></h1>
                    <p class="wtt-lead">A boutique brokerage with 1,200+ closings. We don't list everything — we list what we believe in. And we negotiate like it's our own money.</p>
                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <a href="#contact" class="btn btn-lg wtt-btn-primary">Search Listings</a>
                        <a href="#services" class="btn btn-lg wtt-btn-outline">Book A Viewing</a>
                    </div>
                    <div class="wtt-hero__stats"><div class="stat"><div class="num">1.2K+</div><div class="label">Closings</div></div><div class="stat"><div class="num">15</div><div class="label">Years</div></div><div class="stat"><div class="num">4.8★</div><div class="label">Rating</div></div></div>
                </div>
                <div class="col-lg-5 d-none d-lg-block">
                    <div class="wtt-hero__visual">
                        <i class="bg-glyph fa fa-circle-o-notch"/>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
