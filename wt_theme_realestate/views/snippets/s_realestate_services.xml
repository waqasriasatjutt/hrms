<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_realestate_services" name="WT Theme Real Estate Services">
    <section id="services" class="py-5" style="background:#F8FAFC;">
        <div class="container">
            <div class="text-center mb-5">
                <span class="wtt-eyebrow">Property Types</span>
                <h2 class="wtt-h2 mt-3">Property Types</h2>
                <p class="wtt-lead mx-auto" style="text-align:center;">Every shape, every budget.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-home"/></div>
                        <h3>Family Houses</h3>
                        <p>Single-family homes in vetted neighbourhoods. From starter homes to luxury estates.</p>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-building-o"/></div>
                        <h3>Apartments</h3>
                        <p>Studios to 4-beds in city-centre developments. Both new builds and resale.</p>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-industry"/></div>
                        <h3>Commercial</h3>
                        <p>Office, retail and industrial for owner-occupiers and yield investors.</p>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-tree"/></div>
                        <h3>Land</h3>
                        <p>Build-ready plots, agricultural land, and development opportunities.</p>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-key"/></div>
                        <h3>Rentals</h3>
                        <p>Long-let, short-let and corporate-let — fully vetted tenants, hassle-free management.</p>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-card">
                        <div class="wtt-card__icon"><i class="fa fa-line-chart"/></div>
                        <h3>Investment</h3>
                        <p>Yield-optimised portfolios, off-plan, and post-construction flips.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
