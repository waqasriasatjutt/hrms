                    <section class="wtt-hero" style="padding:5rem 0 3rem;">
                        <div class="container">
                            <span class="wtt-eyebrow mb-3">Property Types</span>
                            <h1 class="wtt-h1">Property Types</h1>
                        </div>
                    </section>
                    <t t-call="wt_theme_realestate.s_realestate_services"/>
                    <t t-call="wt_theme_realestate.s_realestate_features"/>
                    <t t-call="wt_theme_realestate.s_realestate_cta"/>
                </div>
            </t>
        </t>
    </field>
</record>

