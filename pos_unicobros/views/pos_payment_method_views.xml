<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_pos_unicobros" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.unicobros</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <!-- Unicobros -->
                <field name="uni_api_key_entity" placeholder="1231412" invisible="use_payment_terminal != 'unicobros'" required="use_payment_terminal == 'unicobros'"/>
                <field name="uni_bearer_token" placeholder="125123123" invisible="use_payment_terminal != 'unicobros'" required="use_payment_terminal == 'unicobros'"/>
                <field name="uni_id_point_smart" placeholder="ING:123AAA1235566" invisible="use_payment_terminal != 'unicobros'" required="use_payment_terminal == 'unicobros'"/>
            </xpath>
        </field>
    </record>
</odoo>
