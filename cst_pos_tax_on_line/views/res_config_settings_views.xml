<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_pos_limit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_limit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_accounting_section']" position="inside">
                <setting help="Display applied tax amounts on each POS order line and on the receipt.">
                    <field name="pos_order_line_tax" string="Show Tax per Order Line"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>