<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <t  t-name="product_stock_alert.ProductLowStockBadge"
       t-inherit="point_of_sale.ProductCard"
       t-inherit-mode="extension"
       owl="1">

        <xpath expr="//div[hasclass('product-img')]" position="inside">
            <t t-if="this.props.product.low_stock_label">
                <span class="position-absolute top-0 start-0 translate-middle"
                      style="
                        background:#e53935;
                        color:#ffffff;
                        margin-left:20%;
                        margin-top:9%;
                        padding:2px 10px;
                        border-radius:6px;
                        font-size:13px;
                        font-weight:600;
                        display:flex;
                        align-items:center;
                        gap:4px;
                      ">
                    <!-- Warning icon -->
                    <i class="fa fa-exclamation-triangle"/>

                    <!-- Critical icon -->
                    <i class="fa fa-skull-crossbones"/>

                    <t t-esc="this.props.product.low_stock_label"/>
                </span>
            </t>
        </xpath>

    </t>
</odoo>
