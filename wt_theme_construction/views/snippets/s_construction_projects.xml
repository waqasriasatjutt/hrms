                            <span class="wtc-project__cat">Interior</span>
                            <h3 class="wtc-project__title">Grand Hotel Fit-Out</h3>
                        </div>
                    </a>
                </div>
                <div class="col-md-6 col-lg-4">
                    <a href="#" class="d-block wtc-project text-decoration-none">
                        <img src="/web/image/website.library_image_13"
                             onerror="this.style.background='linear-gradient(135deg,#FF6B35 0%,#FFB627 100%)';this.style.height='100%'"
                             alt="Civic Centre"/>
                        <div class="wtc-project__overlay">
                            <span class="wtc-project__cat">Civic</span>
                            <h3 class="wtc-project__title">Riverside Civic Centre</h3>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </section>
</template>

</odoo>
