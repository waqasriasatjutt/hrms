<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Override the default website homepage when this theme is active. -->
<template id="homepage" inherit_id="website.homepage" name="WT Construction Homepage" priority="40">
    <xpath expr="//div[@id='wrap']" position="replace">
        <div id="wrap" class="oe_structure oe_empty">
            <t t-call="wt_theme_construction.s_construction_hero"/>
            <t t-call="wt_theme_construction.s_construction_services"/>
            <t t-call="wt_theme_construction.s_construction_features"/>
            <t t-call="wt_theme_construction.s_construction_projects"/>
            <t t-call="wt_theme_construction.s_construction_stats"/>
            <t t-call="wt_theme_construction.s_construction_team"/>
            <t t-call="wt_theme_construction.s_construction_testimonials"/>
            <t t-call="wt_theme_construction.s_construction_cta"/>
            <t t-call="wt_theme_construction.s_construction_contact"/>
        </div>
    </xpath>
</template>

</odoo>
