                <div id="wrap" class="oe_structure oe_empty">
                    <section class="wtc-hero" style="padding:6rem 0 4rem;">
                        <div class="container">
                            <span class="wtc-eyebrow mb-3">What We Build</span>
                            <h1 class="wtc-display text-white">Six Services. One Accountable Team.</h1>
                        </div>
                    </section>
                    <t t-call="wt_theme_construction.s_construction_services"/>
                    <t t-call="wt_theme_construction.s_construction_projects"/>
