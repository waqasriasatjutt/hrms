<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ===========================================================
     About Us page
     =========================================================== -->
<record id="page_about" model="website.page">
    <field name="name">About Us</field>
    <field name="url">/about-us</field>
    <field name="website_indexed" eval="True"/>
    <field name="is_published" eval="True"/>
    <field name="key">wt_theme_construction.page_about</field>
    <field name="type">qweb</field>
    <field name="arch" type="xml">
        <t name="About Us" t-name="wt_theme_construction.page_about">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <section class="wtc-hero" style="padding:6rem 0 4rem;">
                        <div class="container">
                            <span class="wtc-eyebrow mb-3">About the Firm</span>
                            <h1 class="wtc-display text-white">Building With Precision Since 2005</h1>
                        </div>
                    </section>
                    <t t-call="wt_theme_construction.s_construction_features"/>
                    <t t-call="wt_theme_construction.s_construction_team"/>
                    <t t-call="wt_theme_construction.s_construction_stats"/>
                    <t t-call="wt_theme_construction.s_construction_cta"/>
                </div>
            </t>
        </t>
    </field>
</record>

<!-- ===========================================================
     Services page
     =========================================================== -->
