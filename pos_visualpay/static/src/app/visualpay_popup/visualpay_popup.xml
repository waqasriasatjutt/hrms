<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pos_visualpay_popup.VisualPayPopup">
        <Dialog title="_t('Pagos VisualPay')" footer="false" bodyClass="'p-3 w-100'">

            <!-- 🔹 Tabs -->
            <div class="w-100 mb-4">
                <ul class="nav nav-tabs w-100 border-0 d-flex text-center" style="--bs-nav-tabs-border-width: 0;">
                    <t t-foreach="props.lines" t-as="line" t-key="line.id">
                        <t t-set="idx" t-value="props.lines.indexOf(line)" />
                        <li class="nav-item flex-fill">
                            <a href="#" role="button" t-att-class="state.currentTab === idx
                                   ? 'nav-link active fw-semibold py-3 bg-primary text-white shadow-sm'
                                   : 'nav-link py-3 bg-light text-primary'"
                                style="border-radius: 8px; margin: 0 4px; transition: all 0.3s ease;"
                                t-on-click="() => this.onTabChange(idx)">
                                <t t-esc="line.payment_method_id.name" />
                            </a>
                        </li>
                    </t>
                </ul>
            </div>
            <hr class="mt-0 mb-3" />

            <!-- 🔸 Contenido principal -->
            <t t-if="props.lines and props.lines[state.currentTab]">
                <t t-set="line" t-value="props.lines[state.currentTab]" />
                <t t-set="ev" t-value="state.evidences[state.currentTab]" />

                <div class="d-flex flex-column align-items-center text-center gap-3 p-3">

                    <!-- Nombre del método -->
                    <h3 class="fw-bold text-primary mb-2">
                        <t t-esc="line.payment_method_id.name" />
                    </h3>

                    <p class="text-muted mb-2">
                        <t t-esc="_t('Muestra la siguiente imagen al cliente para proceder con el pago')" />
                    </p>

                    <!-- Imagen QR -->
                    <div class="p-3 rounded shadow-sm bg-light d-flex justify-content-center align-items-center"
                        style="max-width: 250px;">
                        <img t-att-src="'data:image/jpeg;base64,' + line.payment_method_id.visualpay_image"
                            alt="Código QR" style="width: 250px; object-fit: contain;" />
                    </div>

                    <div class="text-muted small w-75">
                        <t t-esc="line.payment_method_id.visualpay_description" />
                    </div>

                    <!-- Monto -->
                    <div class="fs-4 mt-2">
                        <span class="text-muted">
                            <t t-esc="_t('Monto')" />:
                        </span>
                        <strong class="text-success">
                            <t t-esc="env.utils.formatCurrency(line.get_amount())" />
                        </strong>
                    </div>

                    <!-- Evidencia -->
                    <t t-if="line.payment_method_id.visualpay_require_confirmation">
                        <div class="card shadow-sm mt-4 w-100 border-0" style="border-radius: 12px;">
                            <div
                                class="card-body d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">

                                <!-- Área de carga -->
                                <div class="upload-box border border-2 border-primary-subtle rounded-3 d-flex flex-column justify-content-center align-items-center p-3 bg-light flex-shrink-0"
                                    style="width: 220px; height: 180px; cursor: pointer; transition: all 0.3s ease;"
                                    t-on-click="() => this.triggerFileInput(state.currentTab)">
                                    <i class="fa fa-cloud-upload fa-2x text-primary mb-2" />
                                    <span class="fw-semibold text-primary small">
                                        <t t-esc="_t('Subir evidencia')" />
                                    </span>
                                </div>

                                <!-- Preview -->
                                <t t-if="ev.preview">
                                    <div class="position-relative text-center">
                                        <img t-att-src="ev.preview" class="rounded shadow-sm border"
                                            style="width: 100px; height: 100px; object-fit: cover;" />
                                        <button
                                            class="btn btn-sm btn-danger position-absolute top-0 end-0 translate-middle rounded-circle p-1"
                                            t-on-click="() => this.removeImage()"
                                            style="width: 24px; height: 24px; line-height: 1;">
                                            <i class="fa fa-times fa-xs" />
                                        </button>
                                    </div>
                                </t>

                                <!-- Comentario -->
                                <div class="flex-fill text-start">
                                    <label class="fw-semibold text-dark mb-1 d-block">
                                        📝
                                        <t t-esc="_t('Comentario opcional')" />
                                    </label>
                                    <textarea class="form-control" rows="3" placeholder="Escribe un mensaje (opcional)"
                                        t-att-value="ev.comment" t-on-input="(ev) => this.onCommentInput(ev)" />
                                </div>

                            </div>
                        </div>
                    </t>

                </div>
            </t>

            <!-- 🔹 Footer -->
            <div class="modal-footer mt-4 gap-3 justify-content-center">
                <button class="btn btn-outline-secondary px-4" t-on-click="() => this.cancelAll()">
                    <t t-esc="_t('Cancelar')" />
                </button>
                <button class="btn btn-primary px-4" t-on-click="() => this.confirmAll()">
                    <t t-esc="_t('Confirmar todo')" />
                </button>
            </div>

            <!-- 🔸 Input global oculto -->
            <input type="file" id="globalFileInput" t-ref="globalFileInput" accept="image/*" class="d-none"
                t-on-change="(ev) => this.onImageChange(ev)" />

        </Dialog>
    </t>

</templates>