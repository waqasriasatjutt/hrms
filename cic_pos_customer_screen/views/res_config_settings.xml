<odoo>
	<data>
	    <record id="res_config_settings_view_form_cic_customer_screen" model="ir.ui.view">
	        <field name="name">res.config.settings.view.form.inherit.cic_pos_customer_screen</field>
	        <field name="model">res.config.settings</field>
	        <field name="priority" eval="30"/>
	        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
	        <field name="arch" type="xml">
	        	<xpath expr="//block[@id='pos_interface_section']" position="inside" >
	        		<setting id="default_customer_screen" string="Open Default Customer Screen" help="Automatically opens the customer selection screen when POS starts, so you can pick a customer before adding products.">
                        <field name="pos_default_customer_screen"/>
                    </setting>
	            </xpath>
	        </field>
	    </record>
	</data>
</odoo>
