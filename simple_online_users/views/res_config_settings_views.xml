<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_online_users" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.online.users</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <form position="inside">
                <div class="app_settings_block" data-string="Online Users" string="Online Users">
                    <h2>Online Users</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="online_users_visibility_group"/>
                                <div class="text-muted">
                                    Choose which users can see the online users counter in the top bar
                                </div>
                                <div class="mt16">
                                    <field name="online_users_visibility_group" widget="radio"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </field>
    </record>
</odoo>