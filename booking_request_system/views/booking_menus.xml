<!-- booking_request_system/views/booking_menus.xml -->
<odoo>
    <menuitem id="menu_booking_root" name="Bookings" groups="booking_request_system.group_booking_manager,booking_request_system.group_booking_staff"/>

    <menuitem id="menu_booking_rooms" name="Rooms" parent="menu_booking_root"
              action="action_hotel_room"
              groups="booking_request_system.group_booking_manager,booking_request_system.group_booking_staff"/>

    <menuitem id="menu_booking_requests" name="Booking Requests" parent="menu_booking_root"
              action="action_booking_request"
              groups="booking_request_system.group_booking_manager,booking_request_system.group_booking_staff"/>

    <!-- Rooms Action -->
    <record id="action_hotel_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <!-- Booking Requests Action (default to Gantt + Calendar available) -->
    <record id="action_booking_request" model="ir.actions.act_window">
        <field name="name">Booking Requests</field>
        <field name="res_model">booking.request</field>
        <field name="view_mode">gantt,calendar,tree,form</field>
        <field name="context">{'search_default_week': 1}</field>
        <field name="help" type="html">
            <p>Create and manage bookings. Use the Gantt to see all rooms and drag &amp; drop bookings.</p>
        </field>
    </record>
</odoo>
