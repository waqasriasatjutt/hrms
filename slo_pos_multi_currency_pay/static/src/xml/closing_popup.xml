<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('notes-container')]" position="before">
            <div class="pt-2 text-start">
                <t t-if="this.state.multiPayment.length > 0">
                    <h6><strong>Multi Currency Payment</strong></h6>
                    <div class="col-6">
                        <t t-foreach="this.state.multiPayment" t-as="pay" t-key="pay.currency_amount">
                            <div class="d-flex justify-content-between mb-1">
                                <div >
                                    <span><span t-esc="pay.payment_method_id"/> - <span t-esc="pay.payment_currency"/></span>
                                </div>
                                <div>
                                    <span t-esc="pay.price_total_formatted"/>
                                </div>
                            </div>

                        </t>
                    </div>

                </t>
            </div>
        </xpath>
    </t>
</templates>