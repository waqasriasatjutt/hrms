<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="group_pos_read_own_documents" model="res.groups">
            <field name="name">POS: Own Documents Only</field>
            <field name="comment">
                Restrict POS users to view only their own POS configurations, sessions, orders, and payments.
            </field>
        </record>

        <record id="rule_pos_config_read_own" model="ir.rule">
            <field name="name">POS Config: Own Documents</field>
            <field name="model_id" ref="point_of_sale.model_pos_config"/>
            <field name="domain_force">[('user_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('cst_pos_own_documents.group_pos_read_own_documents'))]"/>
        </record>

        <record id="rule_pos_order_read_own" model="ir.rule">
            <field name="name">POS Order: Own Documents</field>
            <field name="model_id" ref="point_of_sale.model_pos_order"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('cst_pos_own_documents.group_pos_read_own_documents'))]"/>
        </record>

        <record id="rule_pos_session_read_own" model="ir.rule">
            <field name="name">Own POS Session</field>
            <field name="model_id" ref="point_of_sale.model_pos_session"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('cst_pos_own_documents.group_pos_read_own_documents'))]"/>
        </record>

        <record id="rule_pos_payment_read_own" model="ir.rule">
            <field name="name">POS Payment: Own Documents</field>
            <field name="model_id" ref="point_of_sale.model_pos_payment"/>
            <field name="domain_force">[('pos_order_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('cst_pos_own_documents.group_pos_read_own_documents'))]"/>
        </record>

    </data>
</odoo>
