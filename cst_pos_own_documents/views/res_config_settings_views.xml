<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_pos_users"
            model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.users</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting id="pos_authorized_users_setting" string="Authorized POS Users"
                         help="Select internal users allowed to access this Point of Sale." company_dependent="1">
                    <field name="pos_user_ids" widget="many2many_tags" options="{'no_create': True}"
                           domain="[('share', '=', False)]" groups="base.group_erp_manager"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
