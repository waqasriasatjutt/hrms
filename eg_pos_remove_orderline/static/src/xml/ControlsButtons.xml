<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="eg_pos_all_in_one_features.ControlButtons" t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension"
       owl="1">
        <xpath expr="//OrderlineNoteButton" position="after">
            <button
                    class="btn btn-light btn-lg flex-shrink-0 ms-auto"
                    t-if="this.env.services.pos.config.allow_remove_orderline"
                    t-on-click="() => removeAllLine()">
                Remove All line
            </button>
        </xpath>
    </t>
</templates>

