<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_acs_appointment_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context({'lang':doc.patient_id.lang})"/>
            <div class="page">
                <div class="oe_structure"/>
                <div class="col-12 mt32 mb8" id="informations">
                    <table class="table" style="margin-top:30px !important">
                        <tr>
                            <td style="border: none;">
                                <strong>Patient:</strong>
                                <span t-field="doc.patient_id.name"/>
                            </td>
                            <td style="border: none;">
                                <strong>Age:</strong>
                                <span t-field="doc.patient_id.age"/>
                            </td>
                        </tr>
                    </table>
                </div>

                <!--Start Patient Appointment Report-->
                <table class="table table-bordered">
                    <tr>
                        <td style="width: 30%;">
                            <strong style="font-size: 20px;">
                                <span>Patient :</span>
                            </strong>
                            <span t-field="doc.patient_id"/>
                        </td>
                        <td style="width: 40%;">
                            <strong style="font-size: 20px;">
                                <span>Appointment :</span>
                            </strong>
                            <span t-field="doc.name"/>
                        </td>
                        <td style="width: 30%;">
                            <strong style="font-size: 20px;">
                                <span>Date :</span>
                            </strong>
                            <span t-field="doc.date"/>
                        </td>
                    </tr>
                </table>

                <!--Patient Details Section-->
                <div style="width: 100%;">
                    <table class="table table-condensed" style="border: 1px solid black;">
                        <tbody>
                            <tr>
                                <td style="border: 1px solid black; width: 20%;">
                                    <strong>Doctor</strong>
                                </td>
                                <td style="border: 1px solid black; width: 15%;">
                                    <strong>Age</strong>
                                </td>
                                <td style="border: 1px solid black;width: 15%;">
                                    <strong>Gender</strong>
                                </td>
                                <td style="border: 1px solid black; width: 25%;">
                                    <strong>Phone</strong>
                                </td>
                                <td style="border: 1px solid black; width: 25%;">
                                    <strong>CNIC</strong>
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid black; width: 20%;">
                                    <p class="m-0" t-field="doc.physician_id"/>
                                </td>
                                <td style="border: 1px solid black; width: 15%;">
                                    <p class="m-0" t-field="doc.patient_id.age"/>
                                </td>
                                <td style="border: 1px solid black;width: 15%;">
                                    <p class="m-0" t-field="doc.patient_id.gender"/>
                                </td>
                                <td style="border: 1px solid black; width: 25%;">
                                    <p class="m-0" t-field="doc.patient_id.phone"/>
                                </td>
                                <td style="border: 1px solid black; width: 25%;">
                                    <p class="m-0" t-field="doc.patient_id.cnic"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div style="width: 100%;">
                    <table class="table table-condensed" style="border: 1px solid black;">
                        <tbody>
                            <tr>
                                <td style="border: 1px solid black; width: 20%;">
                                    <strong>Weight</strong>
                                </td>
                                <td style="border: 1px solid black; width: 15%;">
                                    <strong>HR</strong>
                                </td>
                                <td style="border: 1px solid black;width: 15%;">
                                    <strong>BP</strong>
                                </td>
                                <td style="border: 1px solid black; width: 20%;">
                                    <strong>Temperature</strong>
                                </td>
                                <td style="border: 1px solid black; width: 15%;">
                                    <strong>Fees</strong>
                                </td>
                                <td style="border: 1px solid black; width: 15%;">
                                    <strong>SpO2</strong>
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid black; width: 20%;">
                                    <p class="m-0" t-field="doc.weight"/>
                                </td>
                                <td style="border: 1px solid black; width: 15%;">
                                    <p class="m-0" t-field="doc.hr"/>
                                </td>
                                <td style="border: 1px solid black;width: 15%;">
                                    <p class="m-0" t-field="doc.bp"/>
                                </td>
                                <td style="border: 1px solid black; width: 20%;">
                                    <p class="m-0" t-field="doc.temp"/>
                                </td>
                                <td style="border: 1px solid black; width: 15%;">
                                    <p class="m-0" t-field="doc.fee"/>
                                </td>
                                <td style="border: 1px solid black; width: 15%;">
                                    <p class="m-0" t-field="doc.spo2"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!--appointment Section-->

                <table class="table table-bordered">
                    <tr>
                        <td width="50px">
                            <strong>Subject</strong>
                        </td>
                        <td>Appointment
                            <span t-raw="doc.purpose_id.name"/>
                        </td>
                    </tr>
                </table>

                <table class="table table-bordered">
                    <tr>
                        <th>Description</th>
                    </tr>
                    <tr>
                        <td>
                            <span t-raw="doc.notes"/>
                        </td>
                    </tr>
                </table>
                <div class="col-12 mb32 mt150" style="margin-top: 250px">
                    <span>
                        <u><b>Doctor's Stamp / Signature</b></u>
                    </span>
                </div>
                <div class="oe_structure"/>
                <p style="page-break-before:always;">
                </p>
            </div>
        </t>
    </template>

    <template id="report_acs_appointment">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="acs_hms.report_acs_appointment_document" t-lang="doc.patient_id.partner_id.lang"/>
            </t>
        </t>
    </template>

    <report
            id="action_appointment_report"
            string="Appointment"
            model="hms.appointment"
            report_type="qweb-pdf"
            file="acs_hms.report_acs_appointment"
            name="acs_hms.report_acs_appointment"
            groups="acs_hms.group_hms_receptionist"
    />

</odoo>