<record id="menu_about" model="website.menu">
    <field name="name">About</field>
    <field name="url">/about-us</field>
    <field name="parent_id" search="[('url', '=', '/default-main-menu')]"/>
    <field name="page_id" ref="page_about"/>
    <field name="sequence" type="int">10</field>
</record>
<record id="menu_services" model="website.menu">
    <field name="name">Product Features</field>
    <field name="url">/services</field>
