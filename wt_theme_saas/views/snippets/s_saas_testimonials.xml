<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_saas_testimonials" name="WT Theme SaaS Startup Testimonials">
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <span class="wtt-eyebrow">Reviews</span>
                <h2 class="wtt-h2 mt-3">What People Say</h2>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="wtt-quote">
                        <blockquote>"Replaced Slack + Notion + Linear in one weekend. The team actually uses it. That's the win."</blockquote>
                        <cite>VP Eng</cite>
                        <span class="role">scaling SaaS company</span>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-quote">
                        <blockquote>"The API is what closed it for us. Webhooks for every state change. Build your own everything."</blockquote>
                        <cite>Founder</cite>
                        <span class="role">dev-tools startup</span>
                    </div>
                </div><div class="col-md-6 col-lg-4">
                    <div class="wtt-quote">
                        <blockquote>"Five-minute setup wasn't marketing — it was true. Onboarded 80 people the first day."</blockquote>
                        <cite>COO</cite>
                        <span class="role">agency</span>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
