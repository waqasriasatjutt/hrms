<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="s_saas_faq" name="WT Theme SaaS Startup FAQ">
    <section class="py-5" style="background:#F8FAFC;">
        <div class="container">
            <div class="text-center mb-5">
                <span class="wtt-eyebrow">FAQ</span>
                <h2 class="wtt-h2 mt-3">Common Questions</h2>
            </div>
            <div class="row justify-content-center">
                <div class="col-lg-9">
                    <div class="wtt-faq accordion" id="wtt_saas_faq">
                        <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#wtt_saas_faq_0">Free trial — what's included?</button>
                </h3>
                <div id="wtt_saas_faq_0" class="accordion-collapse collapse show" data-bs-parent="#wtt_saas_faq">
                    <div class="accordion-body">14 days, all Business-tier features unlocked, no credit card needed. Downgrade or cancel any time.</div>
                </div>
            </div><div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#wtt_saas_faq_1">What happens to my data if I cancel?</button>
                </h3>
                <div id="wtt_saas_faq_1" class="accordion-collapse collapse" data-bs-parent="#wtt_saas_faq">
                    <div class="accordion-body">You can export everything as JSON or CSV. We delete your data on request within 30 days. GDPR-compliant.</div>
                </div>
            </div><div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#wtt_saas_faq_2">Self-host?</button>
                </h3>
                <div id="wtt_saas_faq_2" class="accordion-collapse collapse" data-bs-parent="#wtt_saas_faq">
                    <div class="accordion-body">Yes — Enterprise plan supports self-hosted on your AWS/GCP. Source-available license.</div>
                </div>
            </div><div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#wtt_saas_faq_3">SOC2 / GDPR?</button>
                </h3>
                <div id="wtt_saas_faq_3" class="accordion-collapse collapse" data-bs-parent="#wtt_saas_faq">
                    <div class="accordion-body">SOC2 Type II audited. GDPR + HIPAA compliant. EU + US data residency on Business plan.</div>
                </div>
            </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>
</odoo>
