<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="homepage" inherit_id="website.homepage" name="WT Theme SaaS Startup Homepage" priority="40">
    <xpath expr="//div[@id='wrap']" position="replace">
        <div id="wrap" class="oe_structure oe_empty">
            <t t-call="wt_theme_saas.s_saas_hero"/>
            <t t-call="wt_theme_saas.s_saas_services"/>
            <t t-call="wt_theme_saas.s_saas_features"/>
            <t t-call="wt_theme_saas.s_saas_showcase"/>
            <t t-call="wt_theme_saas.s_saas_team"/>
            <t t-call="wt_theme_saas.s_saas_testimonials"/>
            <t t-call="wt_theme_saas.s_saas_faq"/>
            <t t-call="wt_theme_saas.s_saas_cta"/>
            <t t-call="wt_theme_saas.s_saas_contact"/>
        </div>
    </xpath>
</template>
</odoo>
