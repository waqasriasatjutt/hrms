<odoo>
    <record id="view_car_sale_invoice_wizard" model="ir.ui.view">
        <field name="name">car.sale.invoice.wizard.form</field>
        <field name="model">car.sale.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Invoice Options">
                <group>
                    <field name="create_commission_invoice"/>
                    <field name="create_sale_invoice"/>
                </group>
                <footer>
                    <button string="Confirm"
                            type="object"
                            name="action_confirm"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>

        </field>
    </record>
</odoo>
