<odoo>
    <!-- Tree View -->
    <record id="view_car_expense_tree" model="ir.ui.view">
        <field name="name">car.expense.list</field>
        <field name="model">car.expense</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="car_id"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_car_expense_form" model="ir.ui.view">
        <field name="name">car.expense.form</field>
        <field name="model">car.expense</field>
        <field name="arch" type="xml">
            <form string="Car Expense" class="o_form_view" create="true" edit="true">
                <header>
                    <button string="Approve" name="action_approve" type="object"
                            class="btn-primary"
                            invisible="state == 'approved'"/>
                    <button string="Cancel" name="action_cancel" type="object"
                            class="btn-secondary"
                            invisible="state == 'cancel'"/>
                    <button string="Reset to Draft" name="action_reset_to_draft" type="object"
                            class="btn-light"
                            invisible="state == 'draft'"/>
                    <field name="bill_id" readonly="1" invisible="0"
                           context="{'form_view_ref': 'account.view_move_form'}"/>
                    <button name="%(account.action_move_journal_line)d"
                            string="View Bill" type="action"
                            invisible="bill_id == False"/>
                    <!--                    <button string="Close" class="btn-secondary" special="cancel"/>-->
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="car_id"/>
                        <field name="partner_id"/>
                        <field name="date"/>
                        <field name="amount"/>
                        <field name="currency_id"/>
                        <field name="state" readonly="1"/>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>

                <footer>

                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_car_expense" model="ir.actions.act_window">
        <field name="name">Car Expenses</field>
        <field name="res_model">car.expense</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record and track all general or car-specific expenses here.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <!--    <menuitem id="menu_car_expense_root"-->
    <!--              name="Car Management"-->
    <!--              sequence="10"/>-->

    <menuitem id="menu_car_expense_main"
              name="Car Expenses"
              parent="menu_car_management_root"
              action="action_car_expense"
              sequence="20"/>
</odoo>
