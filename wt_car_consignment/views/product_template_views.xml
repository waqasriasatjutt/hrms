                <!--                    </t>-->
                <!--                </templates>-->
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_body bg-white shadow-sm rounded-lg overflow-hidden border border-muted"
                             style="transition: all 0.2s ease; cursor: pointer;">

                            <!-- 🖼️ Car Image -->
                            <div class="position-relative">
                                <img t-att-src="kanban_image('product.template', 'image_1920', record.id.raw_value)"
                                     alt="Car Image" class="img-fluid w-100"
                                     style="height:180px; object-fit:cover;" loading="lazy"/>

                                <!-- 🏷️ Condition Badge -->
                                <t t-if="record.condition.value">
                                    <t t-set="badge_class"
                                       t-value="record.condition.value == 'new' ? 'bg-success text-white' : (record.condition.value == 'used' ? 'bg-warning text-dark' : 'bg-secondary text-white')"/>
                                    <span t-att-class="'position-absolute top-0 end-0 m-2 px-2 py-1 rounded-pill fw-bold text-uppercase small ' + badge_class">
                                        <t t-esc="record.condition.value"/>
                                    </span>
                                </t>
                            </div>

                            <!-- 🚗 Car Info -->
                            <div class="p-3">
                                <!-- Car Name -->
                                <h6 class="fw-bold text-dark mb-1 text-truncate" t-esc="record.name.value"/>

                                <!-- Owner -->
                                <div t-if="record.owner_id.value" class="text-muted small mb-1">
                                    <i class="fa fa-user me-1 text-primary"/>
                                    <t t-esc="record.owner_id.value"/>
                                </div>

                                <!-- Year and Color -->
                                <div class="d-flex justify-content-between text-muted small mb-2">
                                    <span t-if="record.year.value">
                                        <i class="fa fa-calendar me-1 text-info"/>
                                        <t t-esc="record.year.value"/>
                                    </span>
                                    <span t-if="record.color.value">
                                        <i class="fa fa-paint-brush me-1 text-danger"/>
                                        <t t-esc="record.color.value"/>
                                    </span>
                                </div>

                                <!-- 💰 Target Price -->
                                <div t-if="record.target_price.value"
                                     class="border-top pt-2 mt-2 d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-secondary">Price</span>
                                    <span class="fw-bold text-success">
                                        <i class="fa fa-dollar-sign me-1"/>
                                        <t t-esc="record.target_price.value"/>
                                    </span>
                                </div>
                            </div>

                        </div>
                    </t>
                </templates>

            </kanban>
        </field>
    </record>


