    <!-- ===================== ACTION (USES ONLY THESE VIEWS) ===================== -->
    <record id="action_product_template_car" model="ir.actions.act_window">
        <field name="name">Car Management</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('is_consignment', '=', True)]</field>
        <field name="context">{'default_is_consignment': True}</field>
        <field name="view_id" ref="view_product_template_car_tree"/>
    </record>

    <!-- Link both views to the action -->
    <record id="action_product_template_car_views" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_product_template_car_tree"/>
        <field name="act_window_id" ref="action_product_template_car"/>
    </record>

    <record id="action_product_template_car_form_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_product_template_car_form"/>
        <field name="act_window_id" ref="action_product_template_car"/>
    </record>

    <record id="action_product_template_car_kanban_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_product_template_car_kanban"/>
        <field name="act_window_id" ref="action_product_template_car"/>
    </record>

