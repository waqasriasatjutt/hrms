                <!--                                </span>-->

                <!--                                &lt;!&ndash; 💰 Price &ndash;&gt;-->
                <!--                                <div t-if="record.target_price.value" class="mt-2">-->
                <!--                                    <strong>Price:</strong>-->
                <!--                                    <span>-->
                <!--                                        <t t-esc="record.target_price.value"/>-->
                <!--                                    </span>-->
                <!--                                </div>-->

                <!--                                &lt;!&ndash; ⚙️ Condition &ndash;&gt;-->
                <!--                                <div t-if="record.condition.value">-->
                <!--                                    <strong>Condition:</strong>-->
                <!--                                    <span>-->
                <!--                                        <t t-esc="record.condition.value"/>-->
                <!--                                    </span>-->
                <!--                                </div>-->
