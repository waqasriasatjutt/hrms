<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== CAR TREE VIEW ===================== -->
    <record id="view_product_template_car_tree" model="ir.ui.view">
        <field name="name">product.template.car.tree</field>
        <field name="model">product.template</field>
        <field name="priority" eval="50"/>
        <field name="arch" type="xml">
            <list string="Cars">
                <field name="name"/>
                <field name="make"/>
                <field name="model"/>
                <field name="year"/>
                <field name="color"/>
                <field name="owner_id"/>
                <field name="target_price"/>
                <field name="default_code"/>
            </list>
        </field>
    </record>

    <!-- ===================== STANDALONE CAR FORM ===================== -->
    <record id="view_product_template_car_form" model="ir.ui.view">
        <field name="name">product.template.car.form</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">

            <form string="Car Details" class="o_form_view" create="true" edit="true">
                <!-- 🧭 Header with title and chatter features -->
                <header>
                    <field name="active" invisible="1"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sold"/>
                    <button name="action_mark_as_sold"
                            type="object"
                            string="Mark as Sold"
                            class="btn-primary"
                            icon="fa-check"
                            invisible="state == 'sold'"/>
                    <button name="action_set_to_draft"
                            type="object"
                            string="Set to Draft"
                            class="btn-secondary"
                            icon="fa-lock-open"
                            invisible="state == 'draft'"/>
                    <button name="action_view_invoice"
                            type="object"
                            string="View Invoice"
                            class="btn-info"
                            icon="fa-file-invoice"
                            invisible="invoice_id == False"/>
                    <!--                    <button name="action_view_expenses"-->
                    <!--                            type="object"-->
                    <!--                            class="oe_stat_button"-->
                    <!--                            icon="fa-money-bill">-->
                    <!--                            attrs="{'invisible': [('id', '=', False)]}">-->
                    <!--                        <field string="Expenses" name="expense_count" widget="statinfo"/>-->
                    <!--                    </button>-->
                </header>

                <sheet>
                    <!-- 🏷️ Title -->
                    <h1>
                        <field name="name" class="oe_inline" readonly="0" placeholder="Car Name"/>
                    </h1>

                    <!-- 📎 Attachments (Documents) -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                name="action_open_documents"
                                type="object"
                                icon="fa-paperclip">
                            <field string="Attachments" name="product_document_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button"
                                name="action_view_invoices"
                                type="object"
                                icon="fa-file-invoice">
                            <field string="Invoices" name="invoice_ids" widget="statinfo"/>
                        </button>
                        <!--                        <button name="action_view_expenses"-->
                        <!--                                type="object"-->
                        <!--                                class="oe_stat_button"-->
                        <!--                                icon="fa-money-bill"-->
                        <!--                                invisible="id == False">-->
                        <!--                            <field string="Expenses" name="expense_count" widget="statinfo"/>-->
                        <!--                        </button>-->
                    </div>

                    <!-- 🖼️ Image -->
                    <div class="oe_avatar">
                        <field name="image_1920" widget="image" class="oe_avatar"/>
                    </div>

                    <!-- 🧩 Groups -->
                    <group>
                        <group string="Basic Info" readonly="is_locked == True">
                            <field name="is_consignment" readonly="is_locked == True"/>
                            <field name="owner_id" options="{'no_create': False, 'no_edit': False}"
                                   context="{'default_is_company': False}" readonly="is_locked == True"/>
                            <field name="target_price" readonly="is_locked == True"/>
                            <field name="default_code" readonly="is_locked == True"/>
                            <field name="sale_price" readonly="is_locked == True"
                                   required="state == 'sold'"/>
                            <field name="commission_amount" readonly="is_locked == True"/>
                        </group>

                        <group string="Car Specs">
                            <field name="make" readonly="is_locked == True"/>
                            <field name="model" readonly="is_locked == True"/>
                            <field name="year" readonly="is_locked == True"/>
                            <field name="color" readonly="is_locked == True"/>
                            <field name="vin_number" readonly="is_locked == True"/>
                            <field name="registration_number" readonly="is_locked == True"/>
                            <field name="engine_number" readonly="is_locked == True"/>
                            <field name="mileage" readonly="is_locked == True"/>
                            <field name="body_type" readonly="is_locked == True"/>
                        </group>

                        <group string="Additional Info">
                            <field name="fuel_type" readonly="is_locked == True"/>
                            <field name="transmission" readonly="is_locked == True"/>
                            <field name="doors" readonly="is_locked == True"/>
                            <field name="seats" readonly="is_locked == True"/>
                            <field name="public_categ_ids" readonly="is_locked == True" widget="many2many_tags"
                                   string="Categories"/>
                            <!--                            <field name="public_categ_ids" readonly="is_locked == True" string="Categories" />-->
                            <field name="condition" readonly="is_locked == True"/>
                            <field name="purchase_date" readonly="is_locked == True"/>
                            <field name="sale_date" readonly="True"/>
                            <field name="remarks" readonly="is_locked == True"/>
                        </group>
                        <group string="Purchaser Info">
                            <field name="purchaser_id" options="{'no_create': False, 'no_edit': False}"/>
                            <field name="purchaser_phone" readonly="1"/>
                            <field name="purchaser_email" readonly="1"/>
                        </group>

                        <group string="Upsell &amp; Cross-Sell">
                            <field name="accessory_product_ids" widget="many2many_tags" invisible="not sale_ok"
                                   string="Suggested Accessories"
                                   placeholder="Suggested accessories in the eCommerce cart"/>

                            <field name="alternative_product_ids" widget="many2many_tags"
                                   domain="[('id', '!=', id), '|', ('company_id', '=', company_id), ('company_id', '=', False)]"
                                   context="{'search_product_product': True}"
                                   invisible="not sale_ok"
                                   string="Alternative Products"
                                   placeholder="Displayed in bottom of product pages"/>

                            <field name="optional_product_ids" widget="many2many_tags"
                                   string="Optional Products"
                                   placeholder="Optional add-ons for this product"/>
                        </group>
                        <group name="extra_info" string="Ecommerce Shop">
                            <field name="is_published"/>
                            <field
                                    name="website_id"
                                    options="{'no_create': True}"
                                    groups="website.group_multi_website"
                                    placeholder="All"
                            />
                            <field name="website_sequence" groups="base.group_no_one"/>
                            <field name="public_categ_ids" widget="many2many_tags" string="Categories"/>
                            <field
                                    name="website_ribbon_id"
                                    groups="base.group_no_one"
                                    options="{'no_quick_create': True}"
                            />
                        </group>
                        
                        <group string="Ecommerce Description" name="ecom_description">
                            <field
                                    colspan="2"
                                    name="description_ecommerce"
                                    nolabel="1"
                                    placeholder="A detailed,formatted description to promote your product on
                                             this page. Use '/' to discover more features."
                            />
                        </group>


                    </group>


                    <field name="description_ecommerce"
                           invisible="1"/>         <!-- Adding this field as we needed in product_barcodelookup module to store value in this field -->
                    <group colspan="2" name="product_template_images" string="eCommerce Media" invisible="not sale_ok">
                        <field
                                colspan="2"
                                name="product_template_image_ids"
                                class="o_website_sale_image_list"
                                context="{'default_name': name}"
                                mode="kanban"
                                add-label="Add Media"
                                nolabel="1"
                                widget="x2_many_media_viewer"
                                options="{'convert_to_webp': True}"
                        />
                    </group>

                </sheet>

                <!--                <notebook position="inside">-->
            </form>


        </field>
    </record>

    <record id="view_product_template_car_kanban" model="ir.ui.view">
        <field name="name">product.template.car.kanban</field>
