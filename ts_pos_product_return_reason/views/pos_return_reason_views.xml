<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_return_reason_view_form" model="ir.ui.view">
        <field name="name">pos.return.reason.form</field>
        <field name="model">pos.return.reason</field>
        <field name="arch" type="xml">
            <form string="POS Return Reason" duplicate="0">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Reason Title" string="Reason"/>
                        </h1>
                    </div>
                    <notebook>
                        <page name="page_desc" string="Descriptions">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="pos_return_reason_view_list" model="ir.ui.view">
        <field name="name">pos.return.reason.list</field>
        <field name="model">pos.return.reason</field>
        <field name="arch" type="xml">
            <list string="POS Return Reason" sample="1" duplicate="0">
                <field name="sequence" widget="handle"/>
                <field name="name" string="Reason"/>
                <field name="description" string="Description"/>
            </list>
        </field>
    </record>

    <record id="pos_return_reason_view_search" model="ir.ui.view">
        <field name="name">pos.return.reason.search</field>
        <field name="model">pos.return.reason</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_pos_return_reason" model="ir.actions.act_window">
        <field name="name">POS Return Reason</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pos.return.reason</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to create a POS return reason.
            </p>
        </field>
    </record>

    <menuitem id="menu_pos_return_reason"
        name="POS Return reason"
        parent="point_of_sale.menu_point_config_product"
        action="action_pos_return_reason"
        sequence="2"/>

</odoo>
