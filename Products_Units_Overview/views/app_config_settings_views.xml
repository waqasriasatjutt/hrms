<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Configuration view modifications for Point of Sale (PoS) settings -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <!-- Section for displaying total items in PoS interface -->
            <xpath expr="//block[@id='pos_interface_section']" position="after">
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="show_total_items"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="show_total_items" string="Display Total Items"/>
                            <div class="text-muted">
                                When enabled, the total number of items and their quantities
                                will be displayed on the PoS screen.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

            <!-- Section for displaying total quantity on PoS receipts -->
            <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="inside">
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="show_total_quantity"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="show_total_quantity" string="Display Total Quantity"/>
                            <div class="text-muted">
                                When enabled, the total quantity of products will be
                                shown on the PoS receipts.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

        </field>
    </record>
</odoo>
