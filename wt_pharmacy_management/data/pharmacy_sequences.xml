<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_wt_pharmacy_patient" model="ir.sequence">
            <field name="name">Pharmacy Patient ID</field>
            <field name="code">pharmacy.patient</field>
            <field name="prefix">PAT</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_wt_pharmacy_prescription" model="ir.sequence">
            <field name="name">Pharmacy Prescription ID</field>
            <field name="code">pharmacy.prescription</field>
            <field name="prefix">RX</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>