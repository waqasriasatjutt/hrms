<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Product Template Form View to add Pharmacy fields -->
    <record id="view_product_template_form_inherit_wt_pharmacy" model="ir.ui.view">
        <field name="name">product.template.form.inherit.pharmacy</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Add the 'Is a Medicine' checkbox near the top -->
            <xpath expr="//div[@name='options']" position="inside">
                <div>
                    <field name="is_medicine"/>
                    <label for="is_medicine"/>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Pharmacy" name="pharmacy_details" invisible="not is_medicine">
                    <group>
                        <group>
                            <field name="is_prescription_drug"/>
                            <field name="manufacturer"/>
                        </group>
                        <group>
                            <field name="dosage_form"/>
                            <field name="strength"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>