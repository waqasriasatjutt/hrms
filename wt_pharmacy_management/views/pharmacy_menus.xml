<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Main Menu -->
    <menuitem id="menu_wt_pharmacy_root"
              name="Pharmacy"
              sequence="10"/>

    <!-- Prescriptions Menu -->
    <menuitem id="menu_wt_pharmacy_prescriptions"
              name="Prescriptions"
              parent="menu_wt_pharmacy_root"
              action="action_wt_pharmacy_prescription"
              sequence="10"/>

    <!-- Action for Medicines -->
    <record id="action_wt_pharmacy_medicines" model="ir.actions.act_window">
        <field name="name">Medicines</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_medicine', '=', True)]</field>
        <field name="context">{'default_is_medicine': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new medicine
            </p><p>
                You can manage all your pharmacy products here.
            </p>
        </field>
    </record>

    <!-- Medicines Menu -->
    <menuitem id="menu_wt_pharmacy_medicines_list"
              name="Medicines"
              parent="menu_wt_pharmacy_root"
              action="action_wt_pharmacy_medicines"
              sequence="15"/>

    <!-- Actions for Patients and Doctors -->
    <record id="action_wt_pharmacy_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_patient', '=', True)]</field>
        <field name="context">{'default_is_patient': True}</field>
    </record>

    <record id="action_wt_pharmacy_doctor" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_doctor', '=', True)]</field>
        <field name="context">{'default_is_doctor': True}</field>
    </record>

    <!-- Contacts Menu -->
    <menuitem id="menu_wt_pharmacy_contacts"
              name="Contacts"
              parent="menu_wt_pharmacy_root"
              sequence="20"/>

    <menuitem id="menu_wt_pharmacy_patients_list"
              name="Patients"
              parent="menu_wt_pharmacy_contacts"
              action="action_wt_pharmacy_patient"
              sequence="10"/>

    <menuitem id="menu_wt_pharmacy_doctors_list"
              name="Doctors"
              parent="menu_wt_pharmacy_contacts"
              action="action_wt_pharmacy_doctor"
              sequence="20"/>
</odoo>