<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Prescription Form View -->
    <record id="view_wt_pharmacy_prescription_form" model="ir.ui.view">
        <field name="name">pharmacy.prescription.form</field>
        <field name="model">pharmacy.prescription</field>
        <field name="arch" type="xml">
            <form string="Prescription">
                <header>
                    <button name="action_dispense" type="object" string="Dispense" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('dispensed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,dispensed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id" context="{'default_is_patient':True}"/>
                            <field name="doctor_id" context="{'default_is_doctor':True}"/>
                        </group>
                        <group>
                            <field name="prescription_date"/>
                            <field name="sale_order_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Medicines" name="prescription_lines">
                            <!-- This is the corrected v18 way to define an editable list -->
                            <field name="prescription_line_ids">
                                <list editable="bottom">
                                    <field name="drug_id"/>
                                    <field name="quantity"/>
                                    <field name="dosage"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <!-- This is the corrected v18 chatter component -->
                <chatter />
            </form>
        </field>
    </record>

    <!-- Prescription List View -->
    <record id="view_wt_pharmacy_prescription_list" model="ir.ui.view">
        <field name="name">pharmacy.prescription.list</field>
        <field name="model">pharmacy.prescription</field>
        <field name="arch" type="xml">
            <list string="Prescriptions" decoration-info="state == 'draft'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="prescription_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Action for Prescriptions -->
    <record id="action_wt_pharmacy_prescription" model="ir.actions.act_window">
        <field name="name">Prescriptions</field>
        <field name="res_model">pharmacy.prescription</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>