<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_wt_pharmacy" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.pharmacy</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page name="pharmacy_details" string="Pharmacy Info">
                    <group>
                        <group>
                            <field name="is_patient"/>
                            <field name="is_doctor"/>
                        </group>
                    </group>
                    <group string="Patient Information" invisible="not is_patient">
                        <field name="patient_id"/>
                        <field name="date_of_birth"/>
                        <field name="age"/>
                        <field name="gender"/>
                    </group>
                    <group string="Doctor Information" invisible="not is_doctor">
                        <field name="license_id"/>
                        <field name="specialty"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>